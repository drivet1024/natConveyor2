@page "/configuration"
@inject IConfigurationEditor Editor
@inject IApplicationRestartService RestartService

<PageTitle>Configuration</PageTitle>

<header class="dashboard-header">
    <div><span class="eyebrow">PARAMÈTRES</span><h1>Configuration</h1><p>Paramètres communs aux deux lignes et connexions des appareils</p></div>
</header>

@if (_saved)
{
    <div class="config-notice success"><b>Configuration enregistrée.</b> Utilisez le bouton de redémarrage pour appliquer les changements.</div>
}
@if (_restarting)
{
    <div class="config-notice"><b>Redémarrage en cours…</b> La page sera momentanément indisponible, puis reviendra à la même adresse.</div>
}
@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="config-notice error">@_error</div>
}

<EditForm Model="_model" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <section class="config-section">
        <div class="config-section-title"><div><span class="eyebrow">GÉNÉRAL</span><h2>Configuration globale</h2></div></div>
        <div class="config-grid">
            @TextField("Nom", _general.Name, value => _general.Name = value)
            @NumberField("Dépôt", _general.DepotId, value => _general.DepotId = value)
            @NumberField("Shift de départ", _general.ShiftId, value => _general.ShiftId = value)
            <label class="toggle-field"><InputCheckbox @bind-Value="_model.Simulation" /><span>Mode simulation</span><small>Désactiver pour communiquer avec les appareils réels.</small></label>
            <label><span>Nombre de lignes utilisées</span><InputSelect @bind-Value="_model.LineCount"><option value="1">1 ligne</option><option value="2">2 lignes</option></InputSelect><small>Appliqué après enregistrement et redémarrage. Les réglages de la deuxième ligne sont conservés.</small></label>
            <label class="wide-field"><span>Nouvelle chaîne de connexion MySQL</span><InputText type="password" autocomplete="new-password" @bind-Value="_newConnectionString" placeholder="Laisser vide pour conserver la valeur actuelle" /><small>La valeur actuelle n’est jamais affichée dans le navigateur.</small></label>
        </div>
        <div class="config-block">
            <h3>AUTOMATE</h3>
            <div class="config-grid">
                <label><span>Protocole automate</span><InputSelect @bind-Value="_plc.Protocol"><option value="Dde">DDE / RSLinx</option><option value="Tcp">Passerelle TCP</option></InputSelect><small>Connexion commune, contrôlée par START/STOP de la ligne principale.</small></label>
                @if (string.Equals(_plc.Protocol, "Dde", StringComparison.OrdinalIgnoreCase))
                {
                    @TextField("Service DDE", _plc.DdeService, value => _plc.DdeService = value)
                    @TextField("Sujet DDE", _plc.DdeTopic, value => _plc.DdeTopic = value)
                }
                else
                {
                    @TextField("Adresse passerelle automate", _plc.Host, value => _plc.Host = value)
                    @NumberField("Port automate", _plc.Port, value => _plc.Port = value)
                }
                @foreach (var line in _model.GetConfiguredLines())
                {
                    @TextField($"Tag chute automate — ligne {line.Id + 1}", line.Plc.ChuteTag, value => line.Plc.ChuteTag = value)
                }
            </div>
        </div>
            <div class="config-block">
                <h3>TRI ET VALIDATION — COMMUN AUX DEUX LIGNES</h3>
                <div class="config-grid">
                @NumberField("Chute rejet", _sorting.RejectedChute, value => _sorting.RejectedChute = value)
                @NumberField("Chute sans lecture", _sorting.NoReadChute, value => _sorting.NoReadChute = value)
                @NumberField("Délai de corrélation (ms)", _sorting.CorrelationDelayMs, value => _sorting.CorrelationDelayMs = value)
                @NumberField("Fenêtre de corrélation (ms)", _sorting.CorrelationWindowMs, value => _sorting.CorrelationWindowMs = value)
                @DecimalField("Poids maximal", _sorting.MaximumWeight, value => _sorting.MaximumWeight = value)
                @DecimalField("Dimension maximale", _sorting.MaximumDimension, value => _sorting.MaximumDimension = value)
                <label class="toggle-field"><InputCheckbox @bind-Value="_sorting.PostalCodeSort" /><span>Tri par code postal</span></label>
                <label class="toggle-field"><InputCheckbox @bind-Value="_sorting.ValidateDimensionsAndWeight" /><span>Activer le code 98 (poids et dimensions)</span></label>
                <label class="toggle-field"><InputCheckbox @bind-Value="_sorting.EnableCode86" /><span>Activer le code 86</span></label>
                </div>
            </div>
    </section>

    @foreach (var line in _model.GetConfiguredLines())
    {
        <section class="config-section">
            <div class="config-section-title"><div><span class="eyebrow">LIGNE @(line.Id + 1)</span></div><label class="inline-toggle"><InputCheckbox @bind-Value="line.Enabled" /> Activée au démarrage</label></div>
            <div class="config-block">
                <h3>CAMÉRAS</h3>
                <div class="config-grid">
                    <label><span>Mode TCP/IP</span><InputSelect @bind-Value="line.CameraConnectMode"><option value="false">Serveur — l’appareil se connecte</option><option value="true">Client — connexion vers le serveur</option></InputSelect></label>
                    @if (line.CameraConnectMode)
                    {
                        @TextField("Adresse IP du serveur", line.CameraHost, value => line.CameraHost = value)
                    }
                    @NumberField("Port de communication", line.CameraPort, value => line.CameraPort = value)
                </div>
            </div>
            <div class="config-block">
                <h3>DIMENSIONNEUR</h3>
                <div class="config-grid">
                    <label><span>Mode TCP/IP</span><InputSelect @bind-Value="line.DimensionConnectMode"><option value="false">Serveur — l’appareil se connecte</option><option value="true">Client — connexion vers le serveur</option></InputSelect></label>
                    @if (line.DimensionConnectMode)
                    {
                        @TextField("Adresse IP du serveur", line.DimensionHost, value => line.DimensionHost = value)
                    }
                    @NumberField("Port de communication", line.DimensionPort, value => line.DimensionPort = value)
                </div>
            </div>
            <div class="config-block">
                <h3>BALANCE</h3>
                <div class="config-grid">
                    <label><span>Mode TCP/IP</span><InputSelect @bind-Value="line.ScaleConnectMode"><option value="false">Serveur — l’appareil se connecte</option><option value="true">Client — connexion vers le serveur</option></InputSelect></label>
                    @if (line.ScaleConnectMode)
                    {
                        @TextField("Adresse IP du serveur", line.ScaleHost, value => line.ScaleHost = value)
                    }
                    @NumberField("Port de communication", line.ScalePort, value => line.ScalePort = value)
                    <label><span>Protocole balance</span><InputSelect @bind-Value="line.ScaleProtocol"><option>Delimited</option><option>Fixed16From0</option><option>Fixed16From1</option></InputSelect></label>
                </div>
            </div>
        </section>
    }

    <div class="config-actions">
        <button type="submit" class="btn" disabled="@(_saving || _restarting)">@(_saving ? "Enregistrement…" : "Enregistrer")</button>
        <button type="button" class="btn btn-test" disabled="@(_saving || _restarting)" @onclick="SaveAndRestart">Enregistrer et redémarrer</button>
        @if (_saved) { <button type="button" class="btn btn-stop" disabled="@_restarting" @onclick="Restart">Redémarrer maintenant</button> }
        <span>Fichier : @Editor.FilePath</span>
    </div>
</EditForm>

@code {
    private ConveyorOptions _model = new();
    private GeneralOptions _general => _model.General!;
    private PlcOptions _plc => _model.Lines.OrderBy(line => line.Id).First().Plc;
    private SortingOptions _sorting => _model.Sorting!;
    private string _newConnectionString = "";
    private bool _saving;
    private bool _saved;
    private bool _restarting;
    private string? _error;
    protected override void OnInitialized() => _model = Editor.GetEditableCopy();

    private async Task Save()
    {
        _saving = true; _saved = false; _error = null;
        try { await Editor.SaveAsync(_model, _newConnectionString); _newConnectionString = ""; _saved = true; }
        catch (Exception exception) { _error = exception.Message; }
        finally { _saving = false; }
    }

    private async Task SaveAndRestart()
    {
        await Save();
        if (_saved) Restart();
    }

    private void Restart()
    {
        _restarting = true;
        RestartService.ScheduleRestart();
    }

    private RenderFragment TextField(string label, string value, Action<string> changed) => @<label><span>@label</span><input value="@value" @onchange="eventArgs => changed(eventArgs.Value?.ToString() ?? string.Empty)" /></label>;
    private RenderFragment NumberField(string label, int value, Action<int> changed) => @<label><span>@label</span><input type="number" value="@value" @onchange="eventArgs => changed(int.TryParse(eventArgs.Value?.ToString(), out var parsed) ? parsed : value)" /></label>;
    private RenderFragment DecimalField(string label, decimal value, Action<decimal> changed) => @<label><span>@label</span><input type="number" step="0.01" value="@value" @onchange="eventArgs => changed(decimal.TryParse(eventArgs.Value?.ToString(), out var parsed) ? parsed : value)" /></label>;
}
