@page "/configuration"
@inject IConfigurationEditor Editor
@inject IApplicationRestartService RestartService

<PageTitle>Configuration</PageTitle>

@if (!_configurationUnlocked)
{
    <header class="dashboard-header">
        <div><span class="eyebrow">ACCÈS PROTÉGÉ</span><h1>Configuration</h1><p>Saisissez le NIP pour accéder aux paramètres.</p></div>
    </header>
    <section class="pin-gate" aria-labelledby="pin-gate-title">
        <h2 id="pin-gate-title">NIP requis</h2>
        <form @onsubmit="UnlockConfiguration" @onsubmit:preventDefault>
            <label for="configuration-pin">NIP</label>
            <input @ref="_pinInput" id="configuration-pin" type="password" inputmode="numeric" pattern="[0-9]*" maxlength="4"
                   autocomplete="off" autofocus @bind="_submittedPin" @bind:event="oninput" />
            <button type="submit" class="btn">Déverrouiller</button>
        </form>
        @if (!string.IsNullOrWhiteSpace(_pinError))
        {
            <div class="config-notice error" role="alert">@_pinError</div>
        }
    </section>
}
else
{
<header class="dashboard-header">
    <div><span class="eyebrow">PARAMÈTRES</span><h1>Configuration</h1><p>Paramètres communs aux deux lignes et connexions des appareils</p></div>
</header>

@if (_saved)
{
    <div class="config-notice success"><b>Configuration enregistrée.</b> Utilisez le bouton de redémarrage pour appliquer les changements.</div>
}
@if (_restarting)
{
    <div class="config-notice"><b>Redémarrage en cours…</b> La page sera momentanément indisponible, puis reviendra à la même adresse.</div>
}
@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="config-notice error">@_error</div>
}

<EditForm Model="_model" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <section class="config-section">
        <div class="config-section-title"><div><span class="eyebrow">GÉNÉRAL</span><h2>Configuration globale</h2></div></div>
        <div class="config-grid">
            @TextField("Nom", _general.Name, value => _general.Name = value)
            @NumberField("Dépôt", _general.DepotId, value => _general.DepotId = value)
            <label><span>Nom du dépôt</span><InputText @bind-Value="_general.DepotName" placeholder="@_general.GetDepotDisplayName()" /><small>Nom utilisé dans les SMS. Vide : Saint-Hubert pour 1, Gilmore pour 28, Québec pour 2, Toronto pour 12.</small></label>
            <label><span>Conveyor ID</span><InputNumber @bind-Value="_general.ConveyorId" min="0" /><small>Identifiant enregistré dans conveyor_action pour les deux lignes.</small></label>
            @NumberField("Shift de départ", _general.ShiftId, value => _general.ShiftId = value)
            <label><span>Nombre de lignes utilisées</span><InputSelect @bind-Value="_model.LineCount"><option value="1">1 ligne</option><option value="2">2 lignes</option></InputSelect><small>Appliqué après enregistrement et redémarrage. Les réglages de la deuxième ligne sont conservés.</small></label>
            <label class="wide-field"><span>Nouvelle chaîne de connexion MySQL</span><InputText type="password" autocomplete="new-password" @bind-Value="_newConnectionString" placeholder="Laisser vide pour conserver la valeur actuelle" /><small>La valeur actuelle n’est jamais affichée dans le navigateur.</small></label>
        </div>
        <div class="config-block">
            <h3>AUTOMATE</h3>
            <div class="config-grid">
                <label><span>Protocole automate</span><InputSelect @bind-Value="_plc.Protocol"><option value="Dde">DDE / RSLinx</option><option value="OpcDa">OPC DA / RSLinx Classic</option><option value="Tcp">Passerelle TCP</option></InputSelect><small>Connexion commune aux deux lignes. Enregistrer et redémarrer pour appliquer.</small></label>
                @if (string.Equals(_plc.Protocol, "Dde", StringComparison.OrdinalIgnoreCase))
                {
                    @TextField("Service DDE", _plc.DdeService, value => _plc.DdeService = value)
                    @TextField("Sujet DDE", _plc.DdeTopic, value => _plc.DdeTopic = value)
                }
                else if (string.Equals(_plc.Protocol, "OpcDa", StringComparison.OrdinalIgnoreCase))
                {
                    @TextField("Serveur OPC DA (ProgID)", _plc.OpcProgId, value => _plc.OpcProgId = value)
                    <label><span>Ordinateur du serveur OPC</span><InputText @bind-Value="_plc.OpcHost" placeholder="Vide = cet ordinateur" /><small>Nom ou adresse du serveur RSLinx ; accès distant par DCOM.</small></label>
                    <label><span>Sujet OPC RSLinx</span><InputText @bind-Value="_plc.OpcTopic" /><small>Exemple : NATIONEX. Le tag COLISDDE devient [NATIONEX]COLISDDE. Un tag commençant par [ conserve son sujet.</small></label>
                    @NumberField("Actualisation OPC demandée (ms)", _plc.OpcUpdateRateMs, value => _plc.OpcUpdateRateMs = value)
                }
                else
                {
                    @TextField("Adresse passerelle automate", _plc.Host, value => _plc.Host = value)
                    @NumberField("Port automate", _plc.Port, value => _plc.Port = value)
                }
                <label><span>Redémarrage RSLinx — mode</span><InputSelect @bind-Value="_model.RslinxRestart.Mode"><option value="Service">Service Windows</option><option value="Application">Application Windows</option></InputSelect><small>Sur le serveur Conveyor.Web. La tuile AUTOMATE ouvre la commande de redémarrage.</small></label>
                @TextField("Nom du service Windows RSLinx", _model.RslinxRestart.ServiceName, value => _model.RslinxRestart.ServiceName = value)
                <label class="toggle-field"><InputCheckbox @bind-Value="_model.RslinxRestart.AutoRestart" /><span>Redémarrer RSLinx automatiquement si l’automate se déconnecte</span><small>Après 45 secondes de déconnexion : alerte SMS et une tentative par incident. Les SMS exigent l’activation de Twilio. Les déconnexions volontaires sont ignorées.</small></label>
                @if (_model.RslinxRestart.Mode == "Application")
                {
                    <label><span>Chemin complet de RSLINX.exe</span><InputText @bind-Value="_model.RslinxRestart.ExecutablePath" /><small>Conveyor.Web et RSLinx doivent fonctionner dans la même session Windows interactive.</small></label>
                }
                <label><span>Tag démarrage convoyeur</span><InputText @bind-Value="_general.ConveyorStartTag" /><small>Commun aux deux lignes : 1 démarre le convoyeur et 0 l’arrête.</small></label>
                <label><span>Tag fermeture chute 39</span><InputText @bind-Value="_plc.CloseChute39Tag" /><small>Commun aux deux lignes : 1 détourne les colis de la chute 39 vers la recirculation 97 ; 0 rétablit la chute 39. Lu en DDE ou OPC DA.</small></label>
            </div>
        </div>
            <div class="config-block">
                <h3>TRI ET VALIDATION — COMMUN AUX DEUX LIGNES</h3>
                <div class="config-grid">
                @NumberField("Chute rejet", _sorting.RejectedChute, value => _sorting.RejectedChute = value)
                @NumberField("Chute sans lecture", _sorting.NoReadChute, value => _sorting.NoReadChute = value)
                @NumberField("Délai de corrélation (ms)", _sorting.CorrelationDelayMs, value => _sorting.CorrelationDelayMs = value)
                @NumberField("Fenêtre de corrélation (ms)", _sorting.CorrelationWindowMs, value => _sorting.CorrelationWindowMs = value)
                @DecimalField("Poids maximal", _sorting.MaximumWeight, value => _sorting.MaximumWeight = value)
                @DecimalField("Dimension maximale", _sorting.MaximumDimension, value => _sorting.MaximumDimension = value)
                <label><span>Seuil petit colis (po)</span><input type="number" min="0" step="0.01" @bind="_sorting.SmallParcelMaximumSide" /><small>Les deux conditions sont requises : plus grande mesure ≤ ce seuil ET poids strictement inférieur au seuil colis léger. Exemple avec 6 po et 2 lb : 4 × 6 × 3 et 1,5 lb compte comme petit colis. Un seuil à 0 désactive le compteur petits colis.</small></label>
                <label><span>Seuil colis léger (lb)</span><input type="number" min="0" step="0.01" @bind="_sorting.LightParcelMaximumWeight" /><small>Le poids doit être strictement inférieur au seuil. 0 désactive le compteur.</small></label>
                <label class="toggle-field"><InputCheckbox @bind-Value="_sorting.PostalCodeSort" /><span>Tri par code postal</span></label>
                <label class="toggle-field"><InputCheckbox @bind-Value="_sorting.ValidateDimensionsAndWeight" /><span>Mode 98 actif au démarrage</span><small>OFF par défaut. Cette valeur est réappliquée aux deux lignes après chaque redémarrage.</small></label>
                <label class="toggle-field"><InputCheckbox @bind-Value="_sorting.EnableCode86" /><span>Activer le code 86</span></label>
                </div>
            </div>
    </section>

    <section class="config-section">
        <div class="config-section-title"><div><span class="eyebrow">STATISTIQUES</span><h2>Sauvegarde des compteurs</h2></div></div>
        <div class="config-grid">
            <label class="toggle-field"><InputCheckbox @bind-Value="_model.Statistics.Enabled" /><span>Activer la sauvegarde en continu</span><small>Production : par ligne et total du convoyeur. Maintenance : compteurs séparés par ligne avec line_id. Les trois tables de statistiques sont utilisées sur la base MySQL configurée. Aucun enregistrement en simulation.</small></label>
            <label><span>Heure de début du shift</span><input type="time" @bind="_model.Statistics.ShiftStartTime" /><small>Date et heure enregistrées dans INSERT_DATE, y compris la veille pour un shift de nuit.</small></label>
            <p class="wide-field">Mise à jour en base toutes les 5 secondes. Les deux modes sont remis à zéro au début du shift. Au redémarrage, les compteurs du shift courant sont restaurés avant la connexion des appareils. Enregistrer et redémarrer pour appliquer.</p>
        </div>
    </section>

    <section class="config-section">
        <div class="config-section-title"><div><span class="eyebrow">ALERTES</span><h2>SMS Twilio</h2></div></div>
        <div class="config-grid">
            <label class="toggle-field"><InputCheckbox @bind-Value="_model.Sms.Enabled" /><span>Activer les alertes SMS</span><small>Reset Data, reset compteurs, commandes de marche et connexion/déconnexion des appareils. Aucun SMS envoyé en mode simulation.</small></label>
            @TextField("AccountSid Twilio", _model.Sms.AccountSid, value => _model.Sms.AccountSid = value)
            <label><span>Nouvel AuthToken Twilio</span><InputText type="password" autocomplete="new-password" @bind-Value="_newSmsAuthToken" placeholder="Laisser vide pour conserver le token actuel" /><small>Le token enregistré n’est jamais affiché. Les secrets sont conservés dans le fichier local de configuration, exclu de Git.</small></label>
            <label><span>Numéro Twilio émetteur</span><InputText @bind-Value="_model.Sms.FromNumber" placeholder="+15145551234" /><small>Numéro de votre compte Twilio capable d’envoyer des SMS.</small></label>
            <label class="wide-field"><span>Numéros destinataires</span><InputTextArea @bind-Value="_model.Sms.Recipients" rows="3" placeholder="+15145551234; +14165551234" /><small>Format international avec + et indicatif pays. Séparer par point-virgule, virgule ou saut de ligne. Enregistrer et redémarrer pour appliquer.</small></label>
        </div>
    </section>

    @foreach (var line in _model.GetConfiguredLines())
    {
        <section class="config-section">
            <div class="config-section-title"><div><span class="eyebrow">LIGNE @(line.Id + 1)</span></div><label class="inline-toggle"><InputCheckbox @bind-Value="line.Enabled" /> Activée au démarrage</label></div>
            <div class="config-block">
                <h3>IDENTIFICATION</h3>
                <div class="config-grid">
                    <label><span>ID de ligne MySQL (lineId)</span><InputNumber @bind-Value="line.DatabaseLineId" min="1" /><small>Valeur enregistrée telle quelle dans lineId des scans et line_id des statistiques. Laisser vide pour enregistrer NULL.</small></label>
                </div>
            </div>
            <div class="config-block">
                <h3>TAGS AUTOMATE</h3>
                <div class="config-grid">
                    @TextField("Tag chute automate", line.Plc.ChuteTag, value => line.Plc.ChuteTag = value)
                    @TextField("Tag lecture transfert", line.Plc.TransferTag, value => line.Plc.TransferTag = value)
                    @TextField("Tag faute balance", line.Plc.ScaleFaultTag, value => line.Plc.ScaleFaultTag = value)
                    @NumberField("Colis sans balance avant faute", line.Plc.ScaleFaultParcelThreshold, value => line.Plc.ScaleFaultParcelThreshold = value)
                    @NumberField("Durée impulsion faute (ms)", line.Plc.ScaleFaultPulseMs, value => line.Plc.ScaleFaultPulseMs = value)
                </div>
            </div>
            <div class="config-block">
                <h3>CAMÉRAS</h3>
                <div class="config-grid">
                    <label><span>Mode TCP/IP</span><InputSelect @bind-Value="line.CameraConnectMode"><option value="false">Serveur — l’appareil se connecte</option><option value="true">Client — connexion vers le serveur</option></InputSelect></label>
                    @if (line.CameraConnectMode)
                    {
                        @TextField("Adresse IP du serveur", line.CameraHost, value => line.CameraHost = value)
                    }
                    @NumberField("Port de communication", line.CameraPort, value => line.CameraPort = value)
                </div>
            </div>
            <div class="config-block">
                <h3>DIMENSIONNEUR</h3>
                <div class="config-grid">
                    <label><span>Mode TCP/IP</span><InputSelect @bind-Value="line.DimensionConnectMode"><option value="false">Serveur — l’appareil se connecte</option><option value="true">Client — connexion vers le serveur</option></InputSelect></label>
                    @if (line.DimensionConnectMode)
                    {
                        @TextField("Adresse IP du serveur", line.DimensionHost, value => line.DimensionHost = value)
                    }
                    @NumberField("Port de communication", line.DimensionPort, value => line.DimensionPort = value)
                    <label><span>Convertisseur — modèle</span><InputSelect @bind-Value="line.DimensionConverter.Type"><option value="Old">Vieux (Old)</option><option value="New">Nouveau (New)</option></InputSelect></label>
                    @TextField("Adresse IP du convertisseur (reset)", line.DimensionConverter.IpAddress, value => line.DimensionConverter.IpAddress = value)
                </div>
            </div>
            <div class="config-block">
                <h3>BALANCE</h3>
                <div class="config-grid">
                    <label><span>Mode TCP/IP</span><InputSelect @bind-Value="line.ScaleConnectMode"><option value="false">Serveur — l’appareil se connecte</option><option value="true">Client — connexion vers le serveur</option></InputSelect></label>
                    @if (line.ScaleConnectMode)
                    {
                        @TextField("Adresse IP du serveur", line.ScaleHost, value => line.ScaleHost = value)
                    }
                    @NumberField("Port de communication", line.ScalePort, value => line.ScalePort = value)
                    <label><span>Convertisseur — modèle</span><InputSelect @bind-Value="line.ScaleConverter.Type"><option value="Old">Vieux (Old)</option><option value="New">Nouveau (New)</option></InputSelect></label>
                    @TextField("Adresse IP du convertisseur (reset)", line.ScaleConverter.IpAddress, value => line.ScaleConverter.IpAddress = value)
                    <label><span>Protocole balance</span><InputSelect @bind-Value="line.ScaleProtocol"><option>Delimited</option><option>Fixed16From0</option><option>Fixed16From1</option><option value="StxToCrLf">STX à CR/LF</option></InputSelect></label>
                </div>
            </div>
        </section>
    }

    <div class="config-actions">
        <button type="submit" class="btn" disabled="@(_saving || _restarting)">@(_saving ? "Enregistrement…" : "Enregistrer")</button>
        <button type="button" class="btn btn-test" disabled="@(_saving || _restarting)" @onclick="SaveAndRestart">Enregistrer et redémarrer</button>
        @if (_saved) { <button type="button" class="btn btn-stop" disabled="@_restarting" @onclick="Restart">Redémarrer maintenant</button> }
        <span>Fichier : @Editor.FilePath</span>
    </div>
</EditForm>
}

@code {
    private ElementReference _pinInput;
    private bool _configurationUnlocked;
    private string _submittedPin = "";
    private string? _pinError;
    private int _failedPinAttempts;
    private DateTimeOffset? _pinLockedUntil;
    private ConveyorOptions _model = new();
    private GeneralOptions _general => _model.General!;
    private PlcOptions _plc => _model.Lines.OrderBy(line => line.Id).First().Plc;
    private SortingOptions _sorting => _model.Sorting!;
    private string _newConnectionString = "";
    private string _newSmsAuthToken = "";
    private bool _saving;
    private bool _saved;
    private bool _restarting;
    private string? _error;
    protected override void OnInitialized() => _model = Editor.GetEditableCopy();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_configurationUnlocked)
            await _pinInput.FocusAsync(preventScroll: true);
    }

    private void UnlockConfiguration()
    {
        if (_pinLockedUntil is { } lockedUntil && lockedUntil > DateTimeOffset.Now)
        {
            _pinError = $"Trop de tentatives. Réessayez dans {Math.Ceiling((lockedUntil - DateTimeOffset.Now).TotalSeconds)} secondes.";
            _submittedPin = "";
            return;
        }

        if (ConfigurationAccess.VerifyPin(_submittedPin))
        {
            _configurationUnlocked = true;
            _failedPinAttempts = 0;
            _pinLockedUntil = null;
            _pinError = null;
        }
        else
        {
            _failedPinAttempts++;
            _pinError = "NIP incorrect.";
            if (_failedPinAttempts >= 5)
            {
                _failedPinAttempts = 0;
                _pinLockedUntil = DateTimeOffset.Now.AddSeconds(30);
                _pinError = "Trop de tentatives. Accès bloqué pendant 30 secondes.";
            }
        }
        _submittedPin = "";
    }

    private async Task Save()
    {
        _saving = true; _saved = false; _error = null;
        try
        {
            if (!string.IsNullOrWhiteSpace(_newSmsAuthToken)) _model.Sms.AuthToken = _newSmsAuthToken.Trim();
            await Editor.SaveAsync(_model, _newConnectionString);
            _newConnectionString = ""; _newSmsAuthToken = ""; _saved = true;
        }
        catch (Exception exception) { _error = exception.Message; }
        finally { _saving = false; }
    }

    private async Task SaveAndRestart()
    {
        await Save();
        if (_saved) Restart();
    }

    private void Restart()
    {
        _restarting = true;
        RestartService.ScheduleRestart();
    }

    private RenderFragment TextField(string label, string value, Action<string> changed) => @<label><span>@label</span><input value="@value" @onchange="eventArgs => changed(eventArgs.Value?.ToString() ?? string.Empty)" /></label>;
    private RenderFragment NumberField(string label, int value, Action<int> changed) => @<label><span>@label</span><input type="number" value="@value" @onchange="eventArgs => changed(int.TryParse(eventArgs.Value?.ToString(), out var parsed) ? parsed : value)" /></label>;
    private RenderFragment DecimalField(string label, decimal value, Action<decimal> changed) => @<label><span>@label</span><input type="number" step="0.01" value="@value" @onchange="eventArgs => changed(decimal.TryParse(eventArgs.Value?.ToString(), out var parsed) ? parsed : value)" /></label>;
}
