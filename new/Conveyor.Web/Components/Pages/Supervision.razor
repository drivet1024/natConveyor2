@page "/supervision"
@implements IDisposable
@inject IConveyorRepository Repository
@inject IConveyorSupervisor Supervisor
@inject IOptions<ConveyorOptions> Options

<PageTitle>Opérateur</PageTitle>

@if (_smallParcelLineId is { } smallLineId && _lines.FirstOrDefault(line => line.LineId == smallLineId) is { } smallLine)
{
    <SmallParcelsModal Line="smallLine" OnClose="() => _smallParcelLineId = null" />
}

@if (_missingShipmentLineId is { } missingLineId && _lines.FirstOrDefault(line => line.LineId == missingLineId) is { } missingLine)
{
    <MissingShipmentCustomersModal Line="missingLine" OnClose="() => _missingShipmentLineId = null" />
}

@if (_multipleBarcodeLineId is { } multipleLineId && _lines.FirstOrDefault(line => line.LineId == multipleLineId) is { } multipleLine)
{
    <MultipleBarcodesModal Line="multipleLine" OnClose="() => _multipleBarcodeLineId = null" />
}

@if (_converterLineId is { } converterLineId)
{
    <ConverterResetModal LineId="converterLineId" OnClose="() => _converterLineId = null" />
}

@if (_motionStart is { } startMotion)
{
    <ConveyorActionModal Start="startMotion" Busy="_motionBusy" Completed="_motionCompleted" Message="@_motionMessage" CanChangeOperatingMode="Supervisor.CanChangeOperatingMode" MaintenanceActive="Supervisor.Maintenance" OnConfirm="ConfirmMotion" OnMaintenance="() => ConfirmMotionCore(null, true)" OnClose="() => _motionStart = null" />
}

<header class="supervision-header">
    <div>
        <span class="eyebrow">TEMPS RÉEL</span>
        <h1>Opérateur</h1>
    </div>
    <div class="supervision-header-actions">
        <label class="kpi-style-toggle"><input type="checkbox" role="switch" @bind="_modernKpis" /><span>Nouveau style</span></label>
        <div class="conveyor-rates" aria-label="Compteurs du convoyeur" title="Valeur brute reçue de l'automate">
            <div><strong>@SharedTagCount(Supervisor.FullChutesCount)</strong><span>Chutes pleines</span></div>
            <div><strong>@SharedTagCount(Supervisor.Code42Count)</strong><span>Code 42</span></div>
        </div>
        <section class="supervision-conveyor-controls" aria-label="Commandes du convoyeur">
            <span class="@(Supervisor.ConveyorRunning == true ? "running" : null)">CONVOYEUR</span>
            <button type="button" class="btn btn-start" @onclick="() => OpenMotion(true)">DÉMARRER</button>
            <button type="button" class="btn btn-stop" @onclick="() => OpenMotion(false)">ARRÊTER</button>
        </section>
        <span class="supervision-updated">Actualisé à @UpdatedAt.ToLocalTime().ToString("HH:mm:ss")</span>
    </div>
</header>

<section class="supervision-grid @(_lines.Count == 1 ? "single-line" : null)" aria-label="Opérateur — suivi des lignes">
@foreach (var line in _lines)
{
    var counters = line.Counters;
    var eligibleParcels = Math.Max(0, counters.TotalParcels - counters.NoReads);
    <article class="line-card supervision-line @(_modernKpis ? "modern-line" : null)">
        <div class="line-title compact-line-title">
            <h2 class="line-number">LIGNE @(line.LineId + 1)@if (line.Maintenance) { <span class="maintenance-mode"> - MAINTENANCE</span> }</h2>
            <div class="line-state-badges">
                <span class="sorting-time" title="Temps cumulé où le convoyeur est en marche, depuis la remise à zéro des compteurs.">@(counters.SortingDuration is { } elapsed ? $"{(long)elapsed.TotalHours:00}:{elapsed.Minutes:00}" : "—")</span>
                <span class="run-state @LineStateCss(line)">@LineStateLabel(line)</span>
            </div>
        </div>

        <div class="connections">
            @Connection("Caméra", line.Connections.Camera, line.Connections.Simulated)
            @Connection("Dimensionneur", line.Connections.Dimensioner, line.Connections.Simulated)
            @Connection("Balance", line.Connections.Scale, line.Connections.Simulated)
        </div>

        @if (_modernKpis)
        {
            <div class="operator-kpis" aria-label="Indicateurs de la ligne">
                <fieldset class="kpi-category">
                    <legend>Production</legend>
                    <div class="kpi-category-grid">
                <OperatorKpi Label="Colis convoyés" Value="@counters.TotalParcels.ToString("N0")" Help="@CalculationDescription("Colis convoyés")" />
                <OperatorKpi Label="Triés sans problème" Value="@(FormatPercentage(counters.SortedWithoutIssue, counters.TotalParcels) + " %")" Unit="@counters.SortedWithoutIssue.ToString("N0")" Tone="@KpiThresholds.SortedTone(counters.SortedWithoutIssue, counters.TotalParcels)" Icon="check" Help="@CalculationDescription("Triés sans problème")" />
                <OperatorKpi Label="Cadence" Value="@(counters.ParcelsPerHour?.ToString("N0") ?? "—")" Unit="colis/heure" Tone="@KpiThresholds.CadenceTone(counters.ParcelsPerHour)" Icon="speed" Help="Total convoyé ÷ temps de marche cumulé en heures" />
                    </div>
                </fieldset>
                <fieldset class="kpi-category">
                    <legend>Lecture et mesures</legend>
                    <div class="kpi-category-grid">
                @OperatorCount("Sans lecture", counters.NoReads, counters.TotalParcels, "alert")
                @OperatorCount("Erreurs poids", counters.ScaleErrors, eligibleParcels, "alert", line.Code98Enabled)
                @OperatorCount("Erreurs dimensionneur", counters.DimensionErrors, eligibleParcels, "dimensions", line.Code98Enabled)
                    </div>
                </fieldset>
                <fieldset class="kpi-category">
                    <legend>Particularités des colis</legend>
                    <div class="kpi-category-grid">
                <OperatorKpi Label="Pas dans le système" Value="@counters.RejectedShipmentNotFound.ToString("N0")" Rate="@(FormatPercentage(counters.RejectedShipmentNotFound, counters.TotalParcels) + " %")" Tone="@OperatorTone(counters.RejectedShipmentNotFound, counters.TotalParcels)" Icon="alert" Help="@CalculationDescription("Pas dans le système")" OnClick="() => _missingShipmentLineId = line.LineId" />
                <OperatorKpi Label="Petits colis" Value="@counters.SmallParcels.ToString("N0")" Rate="@(FormatPercentage(counters.SmallParcels, counters.TotalParcels) + " %")" Tone="@OperatorTone(counters.SmallParcels, counters.TotalParcels)" Help="@CalculationDescription("Petits colis")" OnClick="() => _smallParcelLineId = line.LineId" />
                <OperatorKpi Label="Colis inversés" Value="@counters.InverseLengthParcels.ToString("N0")" Rate="@(FormatPercentage(counters.InverseLengthParcels, counters.TotalParcels) + " %")" Tone="@OperatorTone(counters.InverseLengthParcels, counters.TotalParcels)" Icon="rotate" Help="@CalculationDescription("Dimensions inversées")" />
                    </div>
                </fieldset>
            </div>
        }
        else
        {
        <div class="supervision-summary">
            @Metric("Triés sans problème", counters.SortedWithoutIssue, counters.TotalParcels, "Colis avec une route connue, des mesures valides et sans détournement ÷ total des colis", false)
            @VolumeMetric(counters)
            <button type="button" class="supervision-metric metric-button success-metric" aria-haspopup="dialog"
                    aria-label="@($"Afficher les petits colis — ligne {line.LineId + 1}")" @onclick="() => _smallParcelLineId = line.LineId">
                @MetricHelp("Petits colis")
                <strong>@FormatPercentage(counters.SmallParcels, counters.TotalParcels) %</strong>
                <span class="metric-count">@counters.SmallParcels.ToString("N0")</span>
                <span class="metric-label">Petits colis</span>
            </button>
        </div>

        <div class="supervision-metrics rejection-metrics">
            @foreach (var cause in counters.RejectionCauses().Where(cause => cause.Label != "Route non configurée"))
            {
                @if (cause.Label is "Plusieurs code-barres" or "Pas dans le système")
                {
                    <button type="button" class="supervision-metric metric-button @SeverityCss(cause.Count, counters.TotalParcels, true)"
                            aria-haspopup="dialog" aria-label="@($"Afficher les colis : {cause.Label} — ligne {line.LineId + 1}")"
                            @onclick="() => OpenParcelDetails(line.LineId, cause.Label)">
                        @MetricHelp(cause.Label)
                        <strong>@FormatPercentage(cause.Count, counters.TotalParcels) %</strong>
                        <span class="metric-count">@cause.Count.ToString("N0")</span>
                        <span class="metric-label">@cause.Label</span>
                    </button>
                }
                else
                {
                    @Metric(cause.Label, cause.Count, counters.TotalParcels, $"{cause.Label} ÷ total des colis")
                }
            }
            <div class="supervision-metric inverse-dimensions-metric">
                @MetricHelp("Dimensions inversées")
                <div class="inverse-dimensions-values">
                    <strong>@counters.InverseLengthParcels.ToString("N0")</strong>
                    <span>@FormatPercentage(counters.InverseLengthParcels, counters.TotalParcels) %</span>
                </div>
                <span class="metric-label">Dimensions inversées</span>
                <span class="sorting-detail">2e mesure ≥ 1re mesure + 2 po</span>
            </div>
        </div>
        <div class="supervision-metrics">
            @Metric("Sans lecture", counters.NoReads, counters.TotalParcels, "Sans lecture ÷ total des colis")
            @if (line.Code98Enabled)
            {
                @Metric("Erreurs poids", counters.ScaleErrors, eligibleParcels, "Erreurs poids ÷ colis lus")
                @Metric("Erreurs dimensionneur", counters.DimensionErrors, eligibleParcels, "Erreurs dimensions ÷ colis lus")
            }
        </div>

        }

        <LastDecision Decision="line.LastDecision">
            <HeadingContent>
                @if (ConveyorState(line) == true)
                {
                    <LineIdleTime LastParcelAt="line.LastParcelReceivedAt" />
                }
            </HeadingContent>
        </LastDecision>
        @if (!string.IsNullOrWhiteSpace(line.LastError))
        {
            <div class="line-error">@line.LastError</div>
        }

        <div class="supervision-actions">
            <button type="button" class="btn btn-code98 @(line.Code98Enabled ? "code98-on" : "code98-off")"
                    aria-pressed="@(line.Code98Enabled ? "true" : "false")"
                    aria-label="@(line.Code98Enabled ? "Désactiver le code 98 pour cette ligne" : "Activer le code 98 pour cette ligne")"
                    title="@(line.Code98Enabled ? "Code 98 actif — cliquer pour désactiver sur cette ligne" : "Code 98 désactivé — cliquer pour activer sur cette ligne")"
                    @onclick="() => Supervisor.SetCode98Enabled(line.LineId, !line.Code98Enabled)">98</button>
            @if (ConveyorState(line) == true)
            {
                <button type="button" class="btn line-motion @(line.ScaleFaultActive == true ? "line-motion-green" : line.ScaleFaultActive == false ? "line-motion-red" : null)"
                    disabled="@(_lineMotionBusy.Contains(line.LineId) || !line.Connections.Plc || line.ScaleFaultActive is null)"
                    title="Commande du tag faute balance : arrêt = 0, démarrage = 1"
                    @onclick="() => SetLineMotion(line.LineId, line.ScaleFaultActive != true)">
                    @(_lineMotionBusy.Contains(line.LineId) ? "ENVOI…" : line.ScaleFaultActive == true ? "FERMER LIGNE" : line.ScaleFaultActive == false ? "DÉMARRER LIGNE" : "ÉTAT INCONNU")
                </button>
                @if (_lineMotionErrors.TryGetValue(line.LineId, out var motionError))
                {
                    <span class="shift-error" role="alert">@motionError</span>
                }
            }
            @if (!string.IsNullOrEmpty(_shiftError))
            {
                <span class="shift-error" role="alert">@_shiftError <button type="button" class="btn" @onclick="LoadShifts">Réessayer</button></span>
            }
            <div class="line-tools">
                <label class="shift-choice">Shift
                    <select @key="Supervisor.CurrentShiftId" @bind:get="Supervisor.CurrentShiftId" @bind:set="ChangeShift" disabled="@(_changingShift || _shifts.Count == 0)" title="Shift commun aux deux lignes — appliqué aux prochains colis">
                        @if (!_shifts.Any(shift => shift.Id == Supervisor.CurrentShiftId))
                        {
                            <option value="@Supervisor.CurrentShiftId" selected>Shift @Supervisor.CurrentShiftId — non défini</option>
                        }
                        @foreach (var shift in _shifts)
                        {
                            <option value="@shift.Id" selected="@(shift.Id == Supervisor.CurrentShiftId)">@shift.Name</option>
                        }
                    </select>
                </label>
                <button type="button" class="btn gear-button" title="Ouvrir les commandes de la ligne" aria-label="Ouvrir les commandes de la ligne" @onclick="() => _converterLineId = line.LineId">⚙</button>
            </div>
        </div>
    </article>
}
</section>

@code {
    private bool _modernKpis = true;
    private OperatorKpiOptions KpiThresholds => Options.Value.OperatorKpis;
    private string OperatorTone(long count, long total) => KpiThresholds.RateTone(count, total);
    private RenderFragment OperatorCount(string label, long count, long total, string icon, bool enabled = true) => @<OperatorKpi
        Label="@label" Value="@(enabled ? count.ToString("N0") : "—")" Unit="@(enabled ? "" : "Code 98 désactivé")"
        Rate="@(enabled ? FormatPercentage(count, total) + " %" : null)" Icon="@icon"
        Tone="@(enabled ? OperatorTone(count, total) : "inactive")" Help="@CalculationDescription(label)" />;
    private int? _multipleBarcodeLineId;
    private int? _smallParcelLineId;
    private int? _missingShipmentLineId;
    private void OpenParcelDetails(int lineId, string cause)
    {
        if (cause == "Pas dans le système") _missingShipmentLineId = lineId;
        else if (cause == "Plusieurs code-barres") _multipleBarcodeLineId = lineId;
    }
    private IReadOnlyList<LineSnapshot> _lines = [];
    private string SharedTagCount(int? count)
    {
        var running = _lines.Where(line => line.Running).ToArray();
        if (!count.HasValue || running.Length == 0 || running.Any(line => line.Connections.Simulated || !line.Connections.Plc)) return "—";
        return count.Value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fr-CA"));
    }
    private IReadOnlyList<ConveyorShift> _shifts = [];
    private bool _changingShift;
    private string? _shiftError;
    private readonly HashSet<int> _lineMotionBusy = [];
    private readonly Dictionary<int, string> _lineMotionErrors = [];

    private async Task SetLineMotion(int lineId, bool start)
    {
        if (!_lineMotionBusy.Add(lineId)) return;
        _lineMotionErrors.Remove(lineId);
        try { await Supervisor.SetLineMotionAsync(lineId, start); Refresh(); }
        catch (Exception exception) { _lineMotionErrors[lineId] = exception.Message; }
        finally { _lineMotionBusy.Remove(lineId); }
    }
    private int? _converterLineId;
    private bool? _motionStart;
    private bool _motionBusy;
    private bool _motionCompleted;
    private string? _motionMessage;
    private DateTimeOffset UpdatedAt => _lines.Count == 0 ? DateTimeOffset.Now : _lines.Max(line => line.UpdatedAt);

    private void OpenMotion(bool start)
    {
        _motionStart = start;
        _motionCompleted = false;
        _motionMessage = null;
    }

    private Task ConfirmMotion(int? cause) => ConfirmMotionCore(cause, false);

    private async Task ConfirmMotionCore(int? cause, bool maintenance)
    {
        if (_motionBusy || _motionCompleted || _motionStart is not { } start) return;
        _motionBusy = true;
        _motionMessage = "Envoi de la commande…";
        try
        {
            var result = await Supervisor.SetConveyorMotionAsync(start, cause, maintenance);
            if (start)
            {
                _motionCompleted = true;
                _motionMessage = result.Message;
            }
            else
            {
                _motionStart = null;
                _motionMessage = null;
            }
        }
        catch (Exception exception) { _motionMessage = exception.Message; }
        finally { _motionBusy = false; }
    }

    protected override void OnInitialized()
    {
        Supervisor.Changed += OnChanged;
        _refreshTimer = new System.Threading.Timer(_ => OnChanged(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        Refresh();
    }

    protected override async Task OnInitializedAsync() => await LoadShifts();

    private async Task LoadShifts()
    {
        try
        {
            _shifts = await Repository.GetShiftsAsync(CancellationToken.None);
            _shiftError = _shifts.Count == 0 ? "Aucun shift dans la table conveyor_shift." : null;
        }
        catch
        {
            _shiftError = "Impossible de charger les shifts depuis MySQL.";
        }
    }

    private async Task ChangeShift(int shift)
    {
        _changingShift = true;
        _shiftError = null;
        try { await Supervisor.SetShiftAsync(shift); }
        catch (Exception exception) { _shiftError = exception.Message; }
        finally { _changingShift = false; }
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    private void Refresh() => _lines = Supervisor.GetSnapshots();

    private RenderFragment Connection(string label, bool connected, bool simulated) => @<div class="connection-item" title="@(simulated ? "Simulation — aucune connexion physique" : connected ? "Connexion établie" : "Déconnecté")">
        <span class="connection-led @(simulated ? "sim" : connected ? "ok" : "ko")"></span><span>@label</span>
    </div>;

    private RenderFragment Metric(string label, long count, long denominator, string title, bool emphasizeHigh = true) => @<div class="supervision-metric @SeverityCss(count, denominator, emphasizeHigh)" title="@title">
        @MetricHelp(label)
        <strong>@FormatPercentage(count, denominator) %</strong>
        <span class="metric-count">@count.ToString("N0")</span>
        <span class="metric-label">@label</span>
    </div>;

    private RenderFragment VolumeMetric(LineCounters counters) => @<div class="supervision-metric volume-metric" title="Total des colis reçus par la caméra">
        @MetricHelp("Colis convoyés")
        <strong>@counters.TotalParcels.ToString("N0")</strong>
        <span class="metric-label">Colis convoyés</span>
        <span class="sorting-detail" title="Total des colis convoyés ÷ durée de tri en heures">@(counters.ParcelsPerHour?.ToString("N0") ?? "—") colis/heure</span>
    </div>;

    private RenderFragment MetricHelp(string label) => @<span class="metric-help" title="@CalculationDescription(label)" aria-label="@CalculationDescription(label)" @onclick:stopPropagation="true">?</span>;

    private static string CalculationDescription(string label) => label switch
    {
        "Colis convoyés" => "Nombre de passages reçus par la caméra, y compris les ??? et les rejets. Cadence : total convoyé ÷ temps de marche cumulé en heures. Remis à zéro avec les compteurs.",
        "Triés sans problème" => "Colis avec une route connue par expédition ou par code postal, même si le colis est absent de la base, sans rejet ni détournement, et des mesures valides si leur validation est activée. Envoi automate réussi et scan enregistré en production. Pourcentage = ces colis ÷ total convoyé × 100.",
        "Petits colis" => "Colis dont toutes les dimensions sont positives et dont la plus grande dimension est inférieure ou égale au seuil petit colis, avec un poids positif inférieur au seuil colis léger. Pourcentage = petits colis ÷ total convoyé × 100.",
        "Pas dans le système" => "Colis absent de la base avec au moins un code-barres de 11 ou 12 caractères commençant par un préfixe autorisé. Compté une fois, sauf si le colis est trié avec succès par code postal. Pourcentage = ces colis ÷ total convoyé × 100.",
        "Plusieurs code-barres" => "Colis avec plusieurs codes-barres reconnus, envoyé au rejet. Pourcentage = ces colis ÷ total convoyé × 100.",
        "Dimensions inversées" => "Colis dont les deux premières mesures sont positives et dont la deuxième dépasse la première d’au moins 2 po. Pourcentage = ces colis ÷ total convoyé × 100.",
        "Sans lecture" => "Lecture contenant un ? ou colis absent sans code-barres admissible au compteur Pas dans le système, sauf tri réussi par code postal. Compté une seule fois par passage. Pourcentage = sans lecture ÷ total convoyé × 100.",
        "Erreurs poids" => "Poids absent, nul ou supérieur au maximum configuré. Exclut les sans lecture et les colis avec plusieurs codes-barres. Pourcentage = erreurs poids ÷ (total convoyé − sans lecture) × 100.",
        "Erreurs dimensionneur" => "Au moins une dimension absente, nulle ou supérieure au maximum configuré. Exclut les sans lecture et les colis avec plusieurs codes-barres. Pourcentage = erreurs dimensions ÷ (total convoyé − sans lecture) × 100.",
        _ => "Nombre de colis de cette catégorie ÷ total convoyé × 100."
    };

    private static decimal Percentage(long count, long total) => total > 0 ? count * 100m / total : 0;
    private static string FormatPercentage(long count, long total) =>
        Percentage(count, total).ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("fr-CA"));
    private static string SeverityCss(long count, long total, bool emphasizeHigh)
    {
        if (!emphasizeHigh) return "success-metric";
        var percentage = Percentage(count, total);
        return percentage > 3 ? "metric-critical" : percentage > 1 ? "metric-warning" : "";
    }
    private bool? ConveyorState(LineSnapshot line) => line.Running && line.Connections.Plc && !line.Connections.Simulated
        ? Supervisor.ConveyorRunning : null;
    private string LineStateLabel(LineSnapshot line) => ConveyorState(line) switch
    {
        true => "EN MARCHE",
        false => Supervisor.ConveyorStopCause is { } cause ? $"ARRÊTÉ · {cause}" : "ARRÊTÉ",
        _ => "ÉTAT INCONNU"
    };
    private string LineStateCss(LineSnapshot line) => ConveyorState(line) switch { true => "on", false => "off", _ => "unavailable" };

    private System.Threading.Timer? _refreshTimer;
    public void Dispose()
    {
        _refreshTimer?.Dispose();
        Supervisor.Changed -= OnChanged;
    }
}
