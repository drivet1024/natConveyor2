@page "/camera-axis"
@implements IAsyncDisposable
@inject AxisCameraService Camera
@inject AxisRecordingStore Recordings
@inject IConfigurationEditor Editor
@inject IApplicationRestartService RestartService

<PageTitle>Caméra Axis</PageTitle>
<header class="dashboard-header">
    <div><span class="eyebrow">VIDÉO · CONVOYEUR</span><h1>Caméra Axis</h1><p>Direct et enregistrements des colis aux chutes surveillées.</p></div>
    <button class="btn" @onclick="() => _showSettings = !_showSettings">Paramètres</button>
</header>

<div class="axis-status" role="status">
    <span class="status-pill @(_status.Connected ? "online" : "offline")">@(_status.Connected ? "● En direct" : _status.Enabled ? "● Caméra indisponible" : "● À configurer")</span>
    <span>@_status.WaitingParcels colis en approche · @_status.RecordingClips vidéos en cours</span>
    <span>Pré-enregistrement : @_status.BufferSeconds.ToString("0.0") / 10 s</span>
    @if (_status.LastImageAt is { } imageAt) { <span>Dernière image : @imageAt.ToLocalTime().ToString("HH:mm:ss")</span> }
</div>
@if (_status.Error is { } error) { <p class="axis-notice" role="alert">@error</p> }
@if (_status.MissedClips > 0) { <p class="axis-notice">@_status.MissedClips vidéos manquées depuis le démarrage. Vérifier la connexion et le stockage.</p> }

<div class="axis-layout">
    <section class="axis-panel">
        <div class="axis-panel-title"><h2>Direct</h2><span>@_active.Name</span></div>
        <div class="axis-screen">
            @if (_status.Connected) { <img src="/api/axis/live" alt="Vue en direct de la caméra Axis" /> }
            else { <div class="axis-empty">▣<strong>@(_status.Enabled ? "En attente du flux vidéo" : "Connecter la première caméra")</strong><span>Configurer l’adresse, le compte et le mot de passe dans Paramètres.</span></div> }
        </div>
        <p class="axis-help">10 secondes avant l’arrivée estimée, puis 5 secondes après. La collecte reste active lorsque cette page est fermée.</p>
    </section>
    <section class="axis-panel">
        <div class="axis-panel-title"><h2>Chutes surveillées</h2><span>Stations @StationLabel</span></div>
        <div class="axis-chutes">
            @foreach (var chute in _active.TravelSeconds.OrderBy(pair => pair.Key))
            { <div><strong>@chute.Key</strong><span>Arrivée ≈ @TimeSpan.FromSeconds(Math.Round(chute.Value)).ToString(@"m\:ss") après la lecture</span></div> }
        </div>
        <p class="axis-help">Les temps suivent les périodes de marche signalées par l’automate. En arrêt ou avec un état inconnu, le compte à rebours est suspendu. L’arrivée n’est pas confirmée par un capteur de chute.</p>
        <p class="axis-help">@(!_status.Enabled ? "Enregistrement en attente d’activation de la caméra" : _status.RecordingEnabled ? "Enregistrement automatique activé" : "Enregistrement automatique désactivé") · Conservation @_active.RetentionDays jours · Maximum @_active.MaximumStorageGb Go</p>
    </section>
</div>

@if (_showSettings)
{
    <section class="axis-panel axis-settings">
        <h2>Paramètres de la caméra</h2>
        @if (!_unlocked)
        {
            <form @onsubmit="Unlock" @onsubmit:preventDefault>
                <label>NIP de configuration<input type="password" autocomplete="off" maxlength="4" inputmode="numeric" @bind="_pin" /></label>
                <button class="btn" type="submit">Déverrouiller</button>
            </form>
        }
        else
        {
            <EditForm Model="_settings" OnSubmit="Save">
                <div class="axis-fields">
                    <label class="axis-check"><InputCheckbox @bind-Value="_settings.Enabled" /> Activer la caméra et le direct</label>
                    <label class="axis-check"><InputCheckbox @bind-Value="_settings.RecordParcels" /> Enregistrer les colis automatiquement</label>
                    <label>Nom de la caméra<InputText @bind-Value="_settings.Name" maxlength="60" /></label>
                    <label>Répertoire de sauvegarde<InputText @bind-Value="_settings.RecordingDirectory" placeholder="D:\Videos\Axis" /><small>Dossier sur le serveur Conveyor, accessible à son compte Windows.</small></label>
                    <label>Adresse de la caméra<InputText @bind-Value="_settings.BaseUrl" placeholder="http://10.11.5.6" /></label>
                    <label>Compte Axis<InputText @bind-Value="_settings.Username" autocomplete="off" /></label>
                    <label>Nouveau mot de passe<InputText type="password" @bind-Value="_newPassword" autocomplete="new-password" placeholder="Vide : conserver le mot de passe enregistré" /><small>Le mot de passe actuel n’est jamais affiché.</small></label>
                    <label>Source vidéo<InputNumber @bind-Value="_settings.VideoSource" min="1" max="16" /></label>
                    <label>Images par seconde<InputNumber @bind-Value="_settings.FramesPerSecond" min="1" max="25" /></label>
                    <label>Résolution<InputSelect @bind-Value="_settings.Resolution"><option>640x360</option><option>640x480</option><option>1280x720</option></InputSelect></label>
                    <label>Stations de lecture<InputSelect @bind-Value="_station"><option value="both">Les deux stations</option><option value="0">Station 1</option><option value="1">Station 2</option></InputSelect></label>
                    <label>Conserver les vidéos (jours)<InputNumber @bind-Value="_settings.RetentionDays" min="1" max="90" /></label>
                    <label>Espace maximal (Go)<InputNumber @bind-Value="_settings.MaximumStorageGb" min="1" max="500" /></label>
                </div>
                <h3>Temps entre la lecture et la chute</h3>
                <p class="axis-help">Valeurs initiales estimées pour le convoyeur du haut à 240 pieds/minute. Ajuster selon un chronométrage réel jusqu’à la chute du colis.</p>
                @foreach (var chute in _settings.TravelSeconds.Keys.Order().ToArray())
                {
                    <div class="axis-travel" @key="chute">
                        <label>Chute @chute<input type="number" min="1" max="600" step="0.1" value="@_settings.TravelSeconds[chute].ToString(System.Globalization.CultureInfo.InvariantCulture)" @onchange="args => SetTravel(chute, args.Value?.ToString())" /> secondes</label>
                        <button type="button" class="btn" @onclick="() => _settings.TravelSeconds.Remove(chute)">Retirer</button>
                    </div>
                }
                <div class="axis-travel"><label>Autre chute<input type="number" min="1" max="48" @bind="_newChute" /></label><button type="button" class="btn" @onclick="AddChute">Ajouter</button></div>
                <p class="axis-help">La fenêtre reste de 10 secondes avant l’arrivée et 5 secondes après. Les anciennes vidéos sont supprimées automatiquement lorsque la durée de conservation ou l’espace maximal est dépassé.</p>
                <button class="btn" type="submit" disabled="@_saving">Enregistrer les paramètres</button>
                <p class="axis-help">Nom des vidéos : no_colis_nom_cam_mm-jj_hh-mm. Exemple : 12345678901_Axis1_10-03_14-35.avi. L’heure correspond à l’arrivée estimée ; un suffixe évite les doublons.</p>
                @if (_saved)
                {
                    <p class="axis-success">@(_restartRequired ? "Paramètres enregistrés. Redémarrer pour les appliquer." : _settings.RecordParcels ? "Enregistrement automatique activé." : "Enregistrement automatique désactivé. Le direct reste disponible.")</p>
                    @if (_restartRequired) { <button class="btn" type="button" @onclick="Restart">Redémarrer Conveyor</button> }
                }
            </EditForm>
        }
        @if (_formError is { } formError) { <p class="axis-notice" role="alert">@formError</p> }
    </section>
}

<section class="axis-panel axis-library">
    <div class="axis-panel-title"><h2>Enregistrements</h2><input type="search" @bind="_search" @bind:event="oninput" placeholder="Chercher un colis ou une chute" aria-label="Chercher dans les 100 dernières vidéos" /></div>
    <p class="axis-help">100 dernières vidéos · Chaque vidéo correspond à une arrivée estimée. Les vidéos de simulation et les fenêtres incomplètes sont identifiées.</p>
    @if (_selected is { } selected)
    {
        <div class="axis-playback">
            <div class="axis-panel-title"><h3>Chute @selected.Parcel.Chute · @selected.Parcel.Barcode</h3><button class="btn" @onclick="() => _selected = null">Fermer</button></div>
            <div class="axis-screen"><img @key="_replayKey" src="@($"/api/axis/recordings/{selected.Id}/replay?v={_replayKey}")" alt="Enregistrement du colis à la chute" /></div>
            <button class="btn" @onclick="() => _replayKey++">Relire</button>
            <a class="btn" href="@($"/api/axis/recordings/{selected.Id}/download")">Télécharger la vidéo AVI</a>
        </div>
    }
    @if (!_recordings.Any()) { <div class="axis-library-empty">Les vidéos apparaîtront ici après les premiers colis destinés aux chutes surveillées.</div> }
    else
    {
        <div class="axis-table"><table><thead><tr><th>Arrivée estimée</th><th>Colis</th><th>Station</th><th>Chute</th><th>Vidéo</th><th></th></tr></thead><tbody>
        @foreach (var clip in _recordings.Where(Matches))
        {
            <tr @key="clip.Id"><td>@clip.ArrivalAt.ToLocalTime().ToString("dd/MM HH:mm:ss")</td><td class="axis-barcode">@clip.Parcel.Barcode</td><td>@(clip.Parcel.LineId + 1)</td><td>@clip.Parcel.Chute</td><td>@((clip.EndAt - clip.StartAt).TotalSeconds.ToString("0.0")) s @if (clip.Incomplete) { <span class="axis-warning">Incomplète</span> } @if (clip.Simulated) { <span>Simulation</span> }</td><td><button class="btn" @onclick="() => Select(clip)">Lire</button> <a href="@($"/api/axis/recordings/{clip.Id}/download")">Télécharger</a></td></tr>
        }
        </tbody></table></div>
    }
</section>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _refresh;
    private AxisCameraStatus _status = new(false, false, null, 0, 0, 0, 0, null);
    private AxisCameraOptions _active = new(), _settings = new();
    private IReadOnlyList<AxisRecording> _recordings = [];
    private AxisRecording? _selected;
    private int _replayKey, _newChute = 27, _failedPins;
    private bool _showSettings, _unlocked, _saving, _saved, _restartRequired;
    private string _pin = "", _newPassword = "", _station = "both", _search = "";
    private string? _formError;
    private DateTimeOffset _pinLockedUntil;
    private string StationLabel => _active.LineIds.Count == 2 ? "1 et 2" : string.Join(", ", _active.LineIds.Select(id => id + 1));
    protected override void OnInitialized()
    {
        _active = Editor.GetEditableCopy().AxisCamera;
        _settings = Editor.GetEditableCopy().AxisCamera;
        _station = _settings.LineIds.Count == 2 ? "both" : _settings.LineIds[0].ToString();
        _status = Camera.Status;
        ReloadLibrary();
    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _refresh = RefreshAsync();
        return Task.CompletedTask;
    }
    private async Task RefreshAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try { while (await timer.WaitForNextTickAsync(_lifetime.Token)) await InvokeAsync(() => { _status = Camera.Status; ReloadLibrary(); StateHasChanged(); }); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }
    private void ReloadLibrary()
    {
        try { _recordings = Recordings.Recent(); }
        catch (IOException) { _formError = "Impossible de lire les enregistrements."; }
        catch (UnauthorizedAccessException) { _formError = "Accès au stockage vidéo refusé."; }
    }
    private bool Matches(AxisRecording clip) => string.IsNullOrWhiteSpace(_search) || clip.Parcel.Barcode.Contains(_search, StringComparison.OrdinalIgnoreCase) || clip.Parcel.Chute.ToString() == _search.Trim();
    private void Select(AxisRecording clip) { _selected = clip; _replayKey++; }
    private void Unlock()
    {
        if (_pinLockedUntil > DateTimeOffset.UtcNow) { _formError = "Réessayer dans 30 secondes."; _pin = ""; return; }
        _unlocked = ConfigurationAccess.VerifyPin(_pin); _pin = "";
        _formError = _unlocked ? null : "NIP incorrect.";
        if (!_unlocked && ++_failedPins >= 5) { _pinLockedUntil = DateTimeOffset.UtcNow.AddSeconds(30); _failedPins = 0; }
    }
    private void SetTravel(int chute, string? value)
    {
        if (double.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var seconds)) _settings.TravelSeconds[chute] = seconds;
        _saved = false;
    }
    private void AddChute() { if (_newChute is >= 1 and <= 48) _settings.TravelSeconds.TryAdd(_newChute, 90); _saved = false; }
    private async Task Save()
    {
        _saving = true; _saved = false; _formError = null;
        try
        {
            _settings.LineIds = _station == "both" ? [0, 1] : [int.Parse(_station)];
            if (!string.IsNullOrEmpty(_newPassword)) _settings.Password = _newPassword;
            _restartRequired = Camera.NeedsRestart(_settings);
            await Editor.SaveAxisCameraAsync(_settings);
            if (!_restartRequired || !_settings.RecordParcels) Camera.SetRecordingEnabled(_settings.RecordParcels);
            _status = Camera.Status;
            _newPassword = ""; _saved = true;
        }
        catch (Exception exception) { _formError = exception.Message; }
        finally { _saving = false; }
    }
    private void Restart() => RestartService.ScheduleRestart();
    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        if (_refresh is not null) await _refresh;
        _lifetime.Dispose();
    }
}
