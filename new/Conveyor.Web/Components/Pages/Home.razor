@page "/"
@implements IDisposable
@inject ILogger<Home> Logger
@inject IConveyorRepository Repository
@inject IConveyorSupervisor Supervisor
@inject IOptions<ConveyorOptions> Options
@inject IDatabaseMetricsService DatabaseMetrics
@inject ISmsAlerts SmsAlerts

<PageTitle>Contrôle des convoyeurs</PageTitle>

@if (_database.Parcels == 0 || _database.PostalCodes == 0)
{
    <DataWaitModal Parcels="_database.Parcels" PostalCodes="_database.PostalCodes" />
}

@if (_converterLineId is { } converterLineId)
{
    <ConverterResetModal LineId="converterLineId" OnClose="() => _converterLineId = null" />
}

@if (_rslinxDialog)
{
    <RslinxRestartModal OnClose="() => _rslinxDialog = false" />
}

@if (_motionStart is { } startMotion)
{
    <ConveyorActionModal Start="startMotion" Busy="_motionBusy" Completed="_motionCompleted" Message="@_motionMessage" CanChangeOperatingMode="Supervisor.CanChangeOperatingMode" MaintenanceActive="Supervisor.Maintenance" OnConfirm="ConfirmMotion" OnMaintenance="() => ConfirmMotionCore(null, true)" OnClose="() => _motionStart = null" />
}

<header class="dashboard-header">
    <div class="mobile-only mobile-location"><strong>@Options.Value.General?.GetDepotDisplayName()</strong><span>@MobileConveyorName</span></div>
    <div class="control-heading"><h1 class="eyebrow">CENTRE DE CONTRÔLE</h1><span class="software-version" title="Version du logiciel" aria-label="@($"Version du logiciel {SoftwareVersion}")">@SoftwareVersion</span></div>
    <div class="header-summary">
        <section class="conveyor-controls" aria-labelledby="conveyor-controls-title">
            <h2 id="conveyor-controls-title" class="@(Supervisor.ConveyorRunning == true ? "running" : null)"
                title="@(Supervisor.ConveyorRunning == true ? $"Convoyeur en fonction — {MotionTag} = 1" : Supervisor.ConveyorRunning == false ? $"Convoyeur arrêté — {MotionTag} = 0" : $"État {MotionTag} en attente")">CONVOYEUR</h2>
            <div class="conveyor-buttons">
                <button type="button" class="btn btn-start" @onclick="() => OpenMotion(true)">DÉMARRER</button>
                <button type="button" class="btn btn-stop" @onclick="() => OpenMotion(false)">ARRÊTER</button>
            </div>
        </section>
        <button type="button" class="shared-status plc-restart-button" title="@(PlcTitle() + " — cliquer pour redémarrer RSLinx")" aria-label="Automate : ouvrir le redémarrage RSLinx" @onclick="() => _rslinxDialog = true"><span class="connection-led @PlcCss()"></span><span><small>AUTOMATE</small><strong>@PlcLabel()</strong></span></button>
        <div class="database-summary">
            <div class="database-local-status">
                <div class="database-summary-title" title="@DatabaseTitle()"><span class="connection-led @DatabaseCss()"></span><span>BASE LOCALE</span></div>
                <div class="database-count registered-total @(_database.HasOverdueScans ? "overdue" : "")" title="@(_database.HasOverdueScans ? "Au moins un enregistrement attend depuis plus de 5 minutes dans scan_history. Total toutes lignes, actualisé toutes les 2 secondes." : "Total en attente dans scan_history — toutes les lignes, actualisé toutes les 2 secondes")"><strong>@_database.Scans.ToString("N0")</strong><small>En attente</small></div>
            </div>
            <div class="database-count @(_database.Parcels == 0 ? "empty-count" : "")"><strong>@FormatCount(_database.Parcels)</strong><small>colis</small></div>
            <div class="database-count @(_database.PostalCodes == 0 ? "empty-count" : "")"><strong>@FormatCount(_database.PostalCodes)</strong><small>codes postaux</small></div>
            <button type="button" class="btn btn-reset reset-data-button" disabled="@_resettingData" title="Vider scan_history, wb, conveyor_shipment, postalcode, location, code98 et code86 — base commune aux deux lignes" @onclick="ResetData">@(_resettingData ? "Suppression…" : "Reset Data")</button>
        </div>
        <ServiceStatus />
        <div class="conveyor-tag-counts" aria-label="Compteurs du convoyeur">
            <div title="@($"{Options.Value.General?.FullChutesTag} — pourcentage mobile : valeur du tag ÷ total des colis des lignes du convoyeur × 100")"><strong class="desktop-tag-value">@SharedTagCount(Supervisor.FullChutesCount)</strong><strong class="mobile-tag-value">@SharedTagRate(Supervisor.FullChutesCount)</strong><span>Chutes pleines</span></div>
            <div title="@($"{Options.Value.General?.Code42Tag} — pourcentage mobile : valeur du tag ÷ total des colis des lignes du convoyeur × 100")"><strong class="desktop-tag-value">@SharedTagCount(Supervisor.Code42Count)</strong><strong class="mobile-tag-value">@SharedTagRate(Supervisor.Code42Count)</strong><span>Code 42</span></div>
        </div>
        <div class="mobile-only shipment-freshness">
            <span class="mobile-indicator" role="status" title="@ShipmentFreshnessLabel" aria-label="@ShipmentFreshnessLabel"><span class="connection-led @ShipmentFreshnessCss" aria-hidden="true"></span><span>Synchro</span></span>
            <span class="mobile-indicator" role="status" title="@ConveyorMotionLabel" aria-label="@ConveyorMotionLabel"><span class="connection-led @(MobileRunning == true ? "ok" : MobileRunning == false ? "ko" : "sim")" aria-hidden="true"></span><span>Convoyeur</span></span>
        </div>
    </div>
</header>

@if (_resetDataMessage is not null)
{
    <div class="config-notice error" role="status">@_resetDataMessage</div>
}

<section class="line-grid @(_lines.Count == 1 ? "single-line" : null)">
@foreach (var line in _lines)
{
    var mobileLineRunning = ResolveMobileLineRunning(line.ScaleFaultActive, MobileRunning);
    <article class="line-card">
        <div class="line-title compact-line-title">
            <h2 class="line-number">LIGNE @(line.LineId + 1)@if (Supervisor.HasStartedOperatingMode) { <text> - @(Supervisor.Maintenance ? "MAINTENANCE" : "PRODUCTION")</text> }</h2>
            <div class="line-state-badges">
                <span class="run-state desktop-only @(MobileRunning == true ? "on" : MobileRunning == false ? "off" : "unavailable")">@(MobileRunning == true ? "EN MARCHE" : MobileRunning == false ? "ARRÊTÉ" : "ÉTAT INCONNU")</span>
                <span class="run-state mobile-only @(mobileLineRunning == true ? "on" : mobileLineRunning == false ? "off" : "unavailable")"
                      title="En marche uniquement si le tag faute balance vaut 0 et que le convoyeur fonctionne">@(mobileLineRunning == true ? "EN MARCHE" : mobileLineRunning == false ? "ARRÊTÉ" : "ÉTAT INCONNU")</span>
                <span class="mobile-only code98-state @(line.Code98Enabled ? "enabled" : "disabled")"
                      title="@(line.Code98Enabled ? "Code 98 activé" : "Code 98 désactivé")"
                      aria-label="@(line.Code98Enabled ? "Code 98 activé" : "Code 98 désactivé")">98</span>
                <button type="button" class="btn mobile-only mobile-data-button"
                        aria-expanded="@(_mobileDataLines.Contains(line.LineId) ? "true" : "false")"
                        aria-controls="@($"last-decision-{line.LineId}")"
                        aria-label="@($"Afficher ou masquer la dernière décision de la ligne {line.LineId + 1}")"
                        @onclick="() => ToggleMobileData(line.LineId)">DATA</button>
            </div>
        </div>
        <div class="connections">@Connection("Caméra",line.Connections.Camera,line.Connections.Simulated) @Connection("Dimensionneur",line.Connections.Dimensioner,line.Connections.Simulated) @Connection("Balance",line.Connections.Scale,line.Connections.Simulated)</div>
        <div class="mobile-counters">
            <div class="mobile-counter-summary">
                <div class="mobile-counter"><strong>@line.Counters.TotalParcels.ToString("N0")</strong><span>Colis convoyés</span></div>
                @MobileMetric("Triés sans problème", line.Counters.SortedWithoutIssue, line.Counters.TotalParcels, false)
            </div>
            <div class="mobile-counter-rejections">
                @foreach (var cause in line.Counters.RejectionCauses())
                {
                    @MobileMetric(cause.Label, cause.Count, line.Counters.TotalParcels)
                }
                @MobileMetric("Code 68", line.Counters.Code68, line.Counters.TotalParcels)
                @MobileMetric("Petits colis", line.Counters.SmallParcels, line.Counters.TotalParcels, false)
            </div>
            <div class="mobile-counter-quality">
                @MobileMetric("Sans lecture", line.Counters.NoReads, line.Counters.TotalParcels)
                @if (line.Code98Enabled)
                {
                    @MobileMetric("Erreurs poids", line.Counters.ScaleErrors, Math.Max(0, line.Counters.TotalParcels - line.Counters.NoReads))
                    @MobileMetric("Erreurs dim", line.Counters.DimensionErrors, Math.Max(0, line.Counters.TotalParcels - line.Counters.NoReads))
                }
            </div>
        </div>
        <div class="metrics desktop-only"><div class="metric metric-parcels">
            <div><FlashingValue Value="@(line.Counters.TotalParcels.ToString("N0"))"><strong>@line.Counters.TotalParcels.ToString("N0")</strong></FlashingValue><span>Colis</span></div>
        </div>
            @foreach (var cause in line.Counters.RejectionCauses())
            {
                @PercentageMetric(cause.Label, cause.Count, line.Counters.TotalParcels, $"{cause.Label} ÷ total des colis × 100")
            }
            @PercentageMetric("Code 98", line.Counters.Code98, line.Counters.TotalParcels, "Colis dirigés vers la chute 98 ÷ total des colis × 100")
            @PercentageMetric("Code 68", line.Counters.Code68, line.Counters.TotalParcels, "Colis comptés lorsque le tag de transfert vaut 68 ÷ total des colis × 100")
            @PercentageMetric("Sans lecture", line.Counters.NoReads, line.Counters.TotalParcels, "Sans lecture ÷ total des colis × 100")
            @ErrorMetric("Erreurs dim.", line.Counters.DimensionErrors, line.Counters)
            @ScaleErrorMetric(line.Counters)
        </div>
        <div class="desktop-only"><DeviceFeed Line="line" /></div>
        <div id="@($"last-decision-{line.LineId}")" class="decision-section @(_mobileDataLines.Contains(line.LineId) ? "mobile-data-open" : null)"><LastDecision Decision="line.LastDecision" /></div>
        @if (!string.IsNullOrWhiteSpace(line.LastError)) { <div class="line-error desktop-only">@line.LastError</div> }
        <div class="actions desktop-only">
            <button type="button" class="btn btn-code98 @(line.Code98Enabled ? "code98-on" : "code98-off")"
                    aria-pressed="@(line.Code98Enabled ? "true" : "false")"
                    aria-label="@(line.Code98Enabled ? "Désactiver le code 98 pour cette ligne" : "Activer le code 98 pour cette ligne")"
                    title="@(line.Code98Enabled ? "Code 98 actif — poids ou dimensions manquants : chute 98. Cliquer pour désactiver sur cette ligne." : "Code 98 désactivé — conserver la chute de tri. Cliquer pour activer sur cette ligne.")"
                    @onclick="() => Supervisor.SetCode98Enabled(line.LineId, !line.Code98Enabled)">98</button>

            @if (Options.Value.Simulation) { <button class="btn btn-test" @onclick="() => Inject(line.LineId)">Colis test</button> }
            @if (!string.IsNullOrEmpty(_shiftError)) { <span class="shift-error" role="alert">@_shiftError <button type="button" class="btn" @onclick="LoadShifts">Réessayer</button></span> }
            <div class="line-tools">
                <label class="shift-choice">Shift
                    <select @key="Supervisor.CurrentShiftId" @bind:get="Supervisor.CurrentShiftId" @bind:set="ChangeShift" disabled="@(_changingShift || _shifts.Count == 0)" title="Shift commun aux deux lignes — appliqué aux prochains colis">
                        @if (!_shifts.Any(shift => shift.Id == Supervisor.CurrentShiftId))
                        {
                            <option value="@Supervisor.CurrentShiftId" selected>Shift @Supervisor.CurrentShiftId — non défini</option>
                        }
                        @foreach (var shift in _shifts) { <option value="@shift.Id" selected="@(shift.Id == Supervisor.CurrentShiftId)">@shift.Name</option> }
                    </select>
                </label>
                <button type="button" class="btn gear-button" title="Reset des appareils" aria-label="Ouvrir les commandes de reset des appareils" @onclick="() => _converterLineId = line.LineId">⚙</button>
            </div>
        </div>
    </article>
}
</section>

@code {
    private readonly HashSet<int> _mobileDataLines = [];
    private void ToggleMobileData(int lineId)
    {
        if (!_mobileDataLines.Add(lineId)) _mobileDataLines.Remove(lineId);
    }
    private bool? MobileRunning => !PlcSimulated() && PlcConnected() ? Supervisor.ConveyorRunning : null;
    internal static bool? ResolveMobileLineRunning(bool? scaleFaultActive, bool? conveyorRunning) =>
        scaleFaultActive == true || conveyorRunning == false ? false
        : scaleFaultActive == false && conveyorRunning == true ? true : null;
    private string SharedTagCount(int? count) => !PlcSimulated() && PlcConnected() && count.HasValue ? count.Value.ToString("N0") : "—";
    private string SharedTagRate(int? count) => !PlcSimulated() && PlcConnected() && count.HasValue
        ? Percentage(count.Value, _lines.Sum(line => line.Counters.TotalParcels)).ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("fr-CA")) + " %"
        : "—";
    private string ConveyorMotionLabel => MobileRunning == true ? "Convoyeur en fonction" : MobileRunning == false ? "Convoyeur arrêté" : "État du convoyeur inconnu";
    private string MobileConveyorName => Options.Value.General?.DepotId == 1
        ? "Convoyeur du " + (Options.Value.GetConfiguredLines().Any(line => line.DatabaseLineId == 3) ? "bas" : "haut")
        : Options.Value.General?.ConveyorId is { } id ? $"Convoyeur {id} — {Options.Value.General.Name}" : Options.Value.General?.Name ?? "Convoyeur";
    private bool ShipmentFreshnessKnown => _database.Connected && !_database.Simulated &&
        DateTimeOffset.Now - _database.UpdatedAt <= TimeSpan.FromSeconds(15) && _database.HasRecentShipmentUpdates.HasValue;
    private string ShipmentFreshnessCss => !ShipmentFreshnessKnown ? "sim" : _database.HasRecentShipmentUpdates == true ? "ok" : "ko";
    private string ShipmentFreshnessLabel => _database.Simulated ? "Synchro : simulation" : !ShipmentFreshnessKnown ? "Synchro : vérification indisponible"
        : _database.HasRecentShipmentUpdates == true ? "Synchro : colis mis à jour dans les 60 dernières minutes" : "Synchro : aucun colis mis à jour dans les 60 dernières minutes";
    private bool _rslinxDialog;
    private string MotionTag => Options.Value.General?.ConveyorStartTag ?? ConveyorMotion.DefaultMotionTag;
    private bool? _motionStart;
    private bool _motionBusy;
    private bool _motionCompleted;
    private string? _motionMessage;
    private void OpenMotion(bool start)
    {
        _motionStart = start;
        _motionCompleted = false;
        _motionMessage = null;
    }
    private Task ConfirmMotion(int? cause) => ConfirmMotionCore(cause, false);
    private async Task ConfirmMotionCore(int? cause, bool maintenance)
    {
        if (_motionBusy || _motionCompleted || _motionStart is not { } start) return;
        _motionBusy = true;
        _motionMessage = "Envoi de la commande…";
        try
        {
            var result = await Supervisor.SetConveyorMotionAsync(start, cause, maintenance);
            if (start)
            {
                _motionCompleted = true;
                _motionMessage = result.Message;
            }
            else
            {
                _motionStart = null;
                _motionMessage = null;
            }
        }
        catch (Exception exception) { _motionMessage = exception.Message; }
        finally { _motionBusy = false; }
    }
    private int? _converterLineId;
    private static string SoftwareVersion => "ver " + (System.Reflection.CustomAttributeExtensions
        .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(typeof(Home).Assembly)?.InformationalVersion ?? "V1").TrimStart('V', 'v');
    private IReadOnlyList<ConveyorShift> _shifts = [];
    private bool _changingShift;
    private string? _shiftError;
    protected override async Task OnInitializedAsync()
    {
        await LoadShifts();
    }
    private async Task LoadShifts()
    {
        try
        {
            _shifts = await Repository.GetShiftsAsync(CancellationToken.None);
            _shiftError = _shifts.Count == 0 ? "Aucun shift dans la table conveyor_shift." : null;
        }
        catch { _shiftError = "Impossible de charger les shifts depuis MySQL."; }
    }
    private async Task ChangeShift(int shift)
    {
        _changingShift = true;
        _shiftError = null;
        try { await Supervisor.SetShiftAsync(shift); }
        catch (Exception exception) { _shiftError = exception.Message; }
        finally { _changingShift = false; }
    }
    private IReadOnlyList<LineSnapshot> _lines = [];
    private DatabaseReferenceCounts _database = new(0, 0, 0, false, true, DateTimeOffset.MinValue);
    protected override void OnInitialized() { Supervisor.Changed += OnChanged; DatabaseMetrics.Changed += OnChanged; Refresh(); }
    private RenderFragment Connection(string label, bool connected, bool simulated) => @<div class="connection-item" title="@(simulated ? "Simulation — aucune connexion physique" : connected ? "Connexion établie" : "Déconnecté")"><span class="connection-led @(simulated ? "sim" : connected ? "ok" : "ko")"></span><span>@label</span></div>;
    private RenderFragment ErrorMetric(string label, long errors, LineCounters counters) =>
        PercentageMetric(label, errors, counters.TotalParcels - counters.NoReads,
            "Erreurs parmi les colis lus : erreurs ÷ (colis − sans lecture) × 100");
    private RenderFragment ScaleErrorMetric(LineCounters counters) => @<div class="metric metric-scale" title="Erreurs de poids et nombre d'impulsions de faute balance">
        <div>
            <div class="metric-value-row"><FlashingValue Value="@(counters.ScaleErrors.ToString("N0"))"><strong>@counters.ScaleErrors.ToString("N0")</strong></FlashingValue><span class="metric-percentage">@Percentage(counters.ScaleErrors, counters.TotalParcels - counters.NoReads).ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("fr-CA")) %</span></div>
            <span>Erreurs poids</span>
        </div>
        <div class="scale-fault-total"><FlashingValue Value="@(counters.ScaleFaults.ToString("N0"))"><strong>@counters.ScaleFaults.ToString("N0")</strong></FlashingValue><span>Fautes balance</span></div>
    </div>;
    private RenderFragment PercentageMetric(string label, long count, long total, string title) => @<div class="metric" title="@title">
        <div class="metric-value-row"><FlashingValue Value="@(count.ToString("N0"))"><strong>@count.ToString("N0")</strong></FlashingValue><span class="metric-percentage">@Percentage(count, total).ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("fr-CA")) %</span></div>
        <span>@label</span>
    </div>;
    private static decimal Percentage(long count, long total) => total > 0 ? count * 100m / total : 0;
    private RenderFragment MobileMetric(string label, long count, long total, bool emphasizeHigh = true) => @<div
        class="mobile-counter @(emphasizeHigh ? Percentage(count, total) > 3 ? "counter-critical" : Percentage(count, total) > 1 ? "counter-warning" : null : null)"
        title="@($"{label} : {count:N0} ÷ {total:N0} × 100")">
        <strong>@Percentage(count, total).ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("fr-CA")) %</strong>
        <small>@count.ToString("N0") colis</small>
        <span>@label</span>
    </div>;
    private bool _resettingData;
    private string? _resetDataMessage;
    private async Task ResetData()
    {
        if (_resettingData) return;
        _resettingData = true;
        _resetDataMessage = null;
        try
        {
            await Repository.ResetDataAsync(CancellationToken.None);
            SmsAlerts.Notify(Repository.IsSimulation ? "Reset Data simulé" : "Reset Data effectué");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Échec du Reset Data");
            SmsAlerts.Notify("Reset Data interrompu ; suppression potentiellement partielle");
            _resetDataMessage = "Reset Data interrompu. Des tables peuvent déjà avoir été vidées ; consulter les journaux.";
        }
        finally
        {
            try { await DatabaseMetrics.RefreshAfterResetAsync(); }
            finally { _resettingData = false; Refresh(); }
        }
    }
    private Task Inject(int id) => Supervisor.SimulateParcelAsync(id,"12345678901,H2X1Y4",new Dimension(12.4m,8.1m,5.2m),4.75m);
    private void OnChanged() => _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });
    private void Refresh() { _lines = Supervisor.GetSnapshots(); _database = DatabaseMetrics.Current; }
    private bool ShipmentDataStale() => _database.LastShipmentUpdate is { } updated && DateTimeOffset.Now - updated > TimeSpan.FromMinutes(30);
    private string DatabaseCss() => _database.Simulated ? "sim" : !_database.Connected ? "ko" : ShipmentDataStale() ? "stale" : "ok";
    private string DatabaseTitle() => _database.Simulated ? "Base simulée" : !_database.Connected ? "Base locale déconnectée" : ShipmentDataStale() ? "Base connectée — aucune mise à jour des colis depuis plus de 30 minutes" : "Base locale connectée";
    private bool PlcSimulated() => _lines.Count > 0 && _lines.All(line => line.Connections.Simulated);
    private bool PlcConnected() { var running = _lines.Where(line => line.Running).ToArray(); return running.Length > 0 && running.All(line => line.Connections.Plc); }
    private string PlcCss() => PlcSimulated() ? "sim" : PlcConnected() ? "ok" : "ko";
    private string PlcLabel() => PlcSimulated() ? "Simulation" : PlcConnected() ? "Connecté" : "Déconnecté";
    private string PlcTitle() => PlcSimulated() ? "Automate simulé — aucune connexion physique" : PlcConnected() ? "Connexion automate établie" : "Connexion automate indisponible";
    private static string FormatCount(long value) => value.ToString("N0");
    public void Dispose() { Supervisor.Changed -= OnChanged; DatabaseMetrics.Changed -= OnChanged; }
}
