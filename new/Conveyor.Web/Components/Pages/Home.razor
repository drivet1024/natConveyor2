@page "/"
@implements IDisposable
@inject ILogger<Home> Logger
@inject IConveyorRepository Repository
@inject IConveyorSupervisor Supervisor
@inject IOptions<ConveyorOptions> Options
@inject IDatabaseMetricsService DatabaseMetrics

<PageTitle>Contrôle des convoyeurs</PageTitle>

@if (_database.Parcels == 0 || _database.PostalCodes == 0)
{
    <DataWaitModal Parcels="_database.Parcels" PostalCodes="_database.PostalCodes" />
}

@if (_converterLineId is { } converterLineId)
{
    <ConverterResetModal LineId="converterLineId" OnClose="() => _converterLineId = null" />
}

@if (_motionStart is { } startMotion)
{
    <ConveyorActionModal Start="startMotion" Busy="_motionBusy" Completed="_motionCompleted" Message="@_motionMessage" OnConfirm="ConfirmMotion" OnClose="() => _motionStart = null" />
}

<header class="dashboard-header">
    <div class="control-heading"><h1 class="eyebrow">CENTRE DE CONTRÔLE</h1><span class="software-version" title="Version du logiciel" aria-label="@($"Version du logiciel {SoftwareVersion}")">@SoftwareVersion</span></div>
    <div class="header-summary">
        <section class="conveyor-controls" aria-labelledby="conveyor-controls-title">
            <h2 id="conveyor-controls-title" class="@(Supervisor.ConveyorRunning == true ? "running" : null)"
                title="@(Supervisor.ConveyorRunning == true ? "Convoyeur en fonction — DEPART_SYSTEMES = 1" : Supervisor.ConveyorRunning == false ? "Convoyeur arrêté — DEPART_SYSTEMES = 0" : "État DEPART_SYSTEMES en attente")">CONVOYEUR</h2>
            <div class="conveyor-buttons">
                <button type="button" class="btn btn-start" @onclick="() => OpenMotion(true)">DÉMARRER</button>
                <button type="button" class="btn btn-stop" @onclick="() => OpenMotion(false)">ARRÊTER</button>
            </div>
        </section>
        <div class="shared-status" title="@PlcTitle()"><span class="connection-led @PlcCss()"></span><div><small>AUTOMATE</small><strong>@PlcLabel()</strong></div></div>
        <div class="database-summary">
            <div class="database-summary-title" title="@DatabaseTitle()"><span class="connection-led @DatabaseCss()"></span><span>BASE LOCALE</span></div>
            <div class="database-count @(_database.Parcels == 0 ? "empty-count" : "")"><strong>@FormatCount(_database.Parcels)</strong><small>colis</small></div>
            <div class="database-count @(_database.PostalCodes == 0 ? "empty-count" : "")"><strong>@FormatCount(_database.PostalCodes)</strong><small>codes postaux</small></div>
            <button type="button" class="btn btn-reset reset-data-button" disabled="@_resettingData" title="Vider scan_history, wb, conveyor_shipment, postalcode, location, code98 et code86 — base commune aux deux lignes" @onclick="ResetData">@(_resettingData ? "Suppression…" : "Reset Data")</button>
        </div>
        <ServiceStatus />
    </div>
</header>

@if (_resetDataMessage is not null)
{
    <div class="config-notice error" role="status">@_resetDataMessage</div>
}

<section class="line-grid">
@foreach (var line in _lines)
{
    <article class="line-card">
        <div class="line-title compact-line-title"><h2 class="line-number">LIGNE @(line.LineId + 1)</h2><span class="run-state @LineStateCss(line)">@LineStateLabel(line)</span></div>
        <div class="connections">@Connection("Caméra",line.Connections.Camera,line.Connections.Simulated) @Connection("Dimensionneur",line.Connections.Dimensioner,line.Connections.Simulated) @Connection("Balance",line.Connections.Scale,line.Connections.Simulated)</div>
        <div class="metrics"><div class="metric metric-parcels">
            <div><strong>@line.Counters.TotalParcels.ToString("N0")</strong><span>Colis</span></div>
            <div class="registered-total @(_database.HasOverdueScans ? "overdue" : "")" title="@(_database.HasOverdueScans ? "Au moins un enregistrement attend depuis plus de 5 minutes dans scan_history. Total toutes lignes, actualisé toutes les 2 secondes." : "Total en attente dans scan_history — toutes les lignes, actualisé toutes les 2 secondes")"><strong>@_database.Scans.ToString("N0")</strong><span>En attente</span></div>
        </div> @PercentageMetric("Rejets", line.Counters.Rejected, line.Counters.TotalParcels, "Rejets ÷ total des colis × 100") @PercentageMetric("Code 98", line.Counters.Code98, line.Counters.TotalParcels, "Colis dirigés vers la chute 98 ÷ total des colis × 100") @PercentageMetric("Sans lecture", line.Counters.NoReads, line.Counters.TotalParcels, "Sans lecture ÷ total des colis × 100") @ErrorMetric("Erreurs dim.", line.Counters.DimensionErrors, line.Counters) @ErrorMetric("Erreurs poids", line.Counters.ScaleErrors, line.Counters) @PercentageMetric("Code 68", line.Counters.Code68, line.Counters.TotalParcels, "Colis comptés lorsque le tag de transfert vaut 68 ÷ total des colis × 100")</div>
        <div class="desktop-only"><DeviceFeed Line="line" /></div>
        <div class="desktop-only"><LastDecision Decision="line.LastDecision" /></div>
        @if (!string.IsNullOrWhiteSpace(line.LastError)) { <div class="line-error desktop-only">@line.LastError</div> }
        <div class="actions desktop-only">
            <button type="button" class="btn btn-code98 @(line.Code98Enabled ? "code98-on" : "code98-off")"
                    aria-pressed="@(line.Code98Enabled ? "true" : "false")"
                    aria-label="@(line.Code98Enabled ? "Désactiver le code 98 pour cette ligne" : "Activer le code 98 pour cette ligne")"
                    title="@(line.Code98Enabled ? "Code 98 actif — poids ou dimensions manquants : chute 98. Cliquer pour désactiver sur cette ligne." : "Code 98 désactivé — conserver la chute de tri. Cliquer pour activer sur cette ligne.")"
                    @onclick="() => Supervisor.SetCode98Enabled(line.LineId, !line.Code98Enabled)">98</button>

            @if (Options.Value.Simulation) { <button class="btn btn-test" @onclick="() => Inject(line.LineId)">Colis test</button> }
            @if (!string.IsNullOrEmpty(_shiftError)) { <span class="shift-error" role="alert">@_shiftError <button type="button" class="btn" @onclick="LoadShifts">Réessayer</button></span> }
            <div class="line-tools">
                <label class="shift-choice">Shift
                    <select value="@Supervisor.CurrentShiftId" disabled="@(_changingShift || _shifts.Count == 0)" @onchange="ChangeShift" title="Shift commun aux deux lignes — appliqué aux prochains colis">
                        @if (!_shifts.Any(shift => shift.Id == Supervisor.CurrentShiftId))
                        {
                            <option value="@Supervisor.CurrentShiftId">Shift @Supervisor.CurrentShiftId — non défini</option>
                        }
                        @foreach (var shift in _shifts) { <option value="@shift.Id">@shift.Name</option> }
                    </select>
                </label>
                <button type="button" class="btn gear-button" title="Reset des appareils" aria-label="Ouvrir les commandes de reset des appareils" @onclick="() => _converterLineId = line.LineId">⚙</button>
            </div>
        </div>
    </article>
}
</section>

@code {
    private bool? _motionStart;
    private bool _motionBusy;
    private bool _motionCompleted;
    private string? _motionMessage;
    private void OpenMotion(bool start)
    {
        _motionStart = start;
        _motionCompleted = false;
        _motionMessage = null;
    }
    private async Task ConfirmMotion(int? cause)
    {
        if (_motionBusy || _motionCompleted || _motionStart is not { } start) return;
        _motionBusy = true;
        _motionMessage = "Envoi de la commande…";
        try
        {
            var result = await Supervisor.SetConveyorMotionAsync(start, cause);
            _motionCompleted = true;
            _motionMessage = result.Message;
        }
        catch (Exception exception) { _motionMessage = exception.Message; }
        finally { _motionBusy = false; }
    }
    private int? _converterLineId;
    private static string SoftwareVersion => "ver " + (System.Reflection.CustomAttributeExtensions
        .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(typeof(Home).Assembly)?.InformationalVersion ?? "V1").TrimStart('V', 'v');
    private IReadOnlyList<ConveyorShift> _shifts = [];
    private bool _changingShift;
    private string? _shiftError;
    protected override async Task OnInitializedAsync()
    {
        await LoadShifts();
    }
    private async Task LoadShifts()
    {
        try
        {
            _shifts = await Repository.GetShiftsAsync(CancellationToken.None);
            _shiftError = _shifts.Count == 0 ? "Aucun shift dans la table conveyor_shift." : null;
        }
        catch { _shiftError = "Impossible de charger les shifts depuis MySQL."; }
    }
    private async Task ChangeShift(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var shift)) return;
        _changingShift = true;
        _shiftError = null;
        try { await Supervisor.SetShiftAsync(shift); }
        catch (Exception exception) { _shiftError = exception.Message; }
        finally { _changingShift = false; }
    }
    private IReadOnlyList<LineSnapshot> _lines = [];
    private DatabaseReferenceCounts _database = new(0, 0, 0, false, true, DateTimeOffset.MinValue);
    protected override void OnInitialized() { Supervisor.Changed += OnChanged; DatabaseMetrics.Changed += OnChanged; Refresh(); }
    private RenderFragment Connection(string label, bool connected, bool simulated) => @<div class="connection-item" title="@(simulated ? "Simulation — aucune connexion physique" : connected ? "Connexion établie" : "Déconnecté")"><span class="connection-led @(simulated ? "sim" : connected ? "ok" : "ko")"></span><span>@label</span></div>;
    private RenderFragment ErrorMetric(string label, long errors, LineCounters counters) =>
        PercentageMetric(label, errors, counters.TotalParcels - counters.NoReads,
            "Erreurs parmi les colis lus : erreurs ÷ (colis − sans lecture) × 100");
    private RenderFragment PercentageMetric(string label, long count, long total, string title) => @<div class="metric" title="@title">
        <div class="metric-value-row"><strong>@count.ToString("N0")</strong><span class="metric-percentage">@Percentage(count, total).ToString("0.#", System.Globalization.CultureInfo.GetCultureInfo("fr-CA")) %</span></div>
        <span>@label</span>
    </div>;
    private static decimal Percentage(long count, long total) => total > 0 ? count * 100m / total : 0;
    private bool _resettingData;
    private string? _resetDataMessage;
    private async Task ResetData()
    {
        if (_resettingData) return;
        _resettingData = true;
        _resetDataMessage = null;
        try
        {
            await Repository.ResetDataAsync(CancellationToken.None);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Échec du Reset Data");
            _resetDataMessage = "Reset Data interrompu. Des tables peuvent déjà avoir été vidées ; consulter les journaux.";
        }
        finally
        {
            try { await DatabaseMetrics.RefreshAsync(); }
            finally { _resettingData = false; Refresh(); }
        }
    }
    private Task Inject(int id) => Supervisor.SimulateParcelAsync(id,"12345678901,H2X1Y4",new Dimension(12.4m,8.1m,5.2m),4.75m);
    private void OnChanged() => _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });
    private void Refresh() { _lines = Supervisor.GetSnapshots(); _database = DatabaseMetrics.Current; }
    private bool ShipmentDataStale() => _database.LastShipmentUpdate is { } updated && DateTimeOffset.Now - updated > TimeSpan.FromMinutes(30);
    private string DatabaseCss() => _database.Simulated ? "sim" : !_database.Connected ? "ko" : ShipmentDataStale() ? "stale" : "ok";
    private string DatabaseTitle() => _database.Simulated ? "Base simulée" : !_database.Connected ? "Base locale déconnectée" : ShipmentDataStale() ? "Base connectée — aucune mise à jour des colis depuis plus de 30 minutes" : "Base locale connectée";
    private bool PlcSimulated() => _lines.Count > 0 && _lines.All(line => line.Connections.Simulated);
    private bool PlcConnected() { var running = _lines.Where(line => line.Running).ToArray(); return running.Length > 0 && running.All(line => line.Connections.Plc); }
    private string PlcCss() => PlcSimulated() ? "sim" : PlcConnected() ? "ok" : "ko";
    private string PlcLabel() => PlcSimulated() ? "Simulation" : PlcConnected() ? "Connecté" : "Déconnecté";
    private string PlcTitle() => PlcSimulated() ? "Automate simulé — aucune connexion physique" : PlcConnected() ? "Connexion automate établie" : "Connexion automate indisponible";
    private static bool LineAvailable(LineSnapshot line) => line.Connections.Simulated ||
        (line.Connections.Camera && line.Connections.Dimensioner && line.Connections.Scale && line.Connections.Database && line.Connections.Plc);
    private static string LineStateLabel(LineSnapshot line) => !line.Running ? "EN ARRÊT" : LineAvailable(line) ? "EN MARCHE" : "NON DISPONIBLE";
    private static string LineStateCss(LineSnapshot line) => !line.Running ? "off" : LineAvailable(line) ? "on" : "unavailable";
    private static string FormatCount(long value) => value.ToString("N0");
    public void Dispose() { Supervisor.Changed -= OnChanged; DatabaseMetrics.Changed -= OnChanged; }
}
