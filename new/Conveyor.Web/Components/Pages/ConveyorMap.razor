@page "/plan-convoyeur"
@implements IAsyncDisposable
@inject IConveyorRepository Repository
@inject IConveyorSupervisor Supervisor
@inject ILogger<ConveyorMap> Logger

<PageTitle>St-Hubert — Convoyeur du haut</PageTitle>

<div class="map-page">
<header class="map-header">
    <div><span class="eyebrow">PLAN DU CONVOYEUR · ST-HUBERT</span><h1>Convoyeur du haut</h1></div>
    <span class="map-status">Plan statique · suivi des colis à venir</span>
</header>

<section class="map-panel" aria-label="Schéma du convoyeur du haut de St-Hubert">
    <div class="map-toolbar">
        <div class="map-legend"><span><i class="belt-key"></i>Convoyeur</span><span><i class="camera-key"></i>Lecture</span><span>→ Sens de circulation</span></div>
        <label class="map-shift">Shift d’affichage
            <select @bind:get="_displayShift" @bind:set="ChangeDisplayShift" disabled="@(_shifts.Count == 0)" title="Consulter les destinations sans modifier le shift du tri">
                @if (!_shifts.Any(shift => shift.Id == _displayShift))
                {
                    <option value="@_displayShift">Shift @_displayShift</option>
                }
                @foreach (var shift in _shifts)
                {
                    <option value="@shift.Id">@shift.Name</option>
                }
            </select>
            <small>Consultation seulement</small>
        </label>
        @if (_shiftError is not null)
        {
            <span class="shift-error" role="alert">@_shiftError <button class="btn" type="button" @onclick="LoadShifts">Réessayer</button></span>
        }
    </div>
    <div class="map-viewport" aria-label="Vue complète du convoyeur">
        <div class="map-canvas"><ConveyorDiagram Destinations="_destinations" DestinationStatus="@_destinationStatus" /></div>
    </div>
    <p class="map-note">St-Hubert — convoyeur du haut uniquement. Schéma simplifié, non à l’échelle. Sorties 1 à 11, 13, 16 et 21 à 41.</p>
</section>

</div>

@code {
    private IReadOnlyDictionary<int, string> _destinations = new Dictionary<int, string>();
    private string? _destinationStatus = "Chargement des destinations…";
    private readonly CancellationTokenSource _stopping = new();
    private Task? _refreshTask;
    private bool _disposed;
    private int? _loadedShift;
    private int _displayShift;
    private IReadOnlyList<ConveyorShift> _shifts = [];
    private string? _shiftError;
    private int _loadVersion;
    private bool _loading;
    private DateTimeOffset _nextRefresh;

    protected override async Task OnInitializedAsync()
    {
        _displayShift = Supervisor.CurrentShiftId;
        await LoadShifts();
        await LoadDestinations();
        if (!_disposed) _refreshTask = RefreshDestinations();
    }

    private async Task LoadShifts()
    {
        try
        {
            _shifts = await Repository.GetShiftsAsync(_stopping.Token);
            _shiftError = _shifts.Count == 0 ? "Aucun shift disponible." : null;
        }
        catch (OperationCanceledException) when (_stopping.IsCancellationRequested) { }
        catch (Exception exception)
        {
            _shiftError = "Impossible de charger les shifts.";
            Logger.LogWarning(exception, "Chargement des shifts du plan impossible");
        }
    }

    internal async Task ChangeDisplayShift(int shift)
    {
        if (_displayShift == shift || !_shifts.Any(item => item.Id == shift)) return;
        _displayShift = shift;
        await LoadDestinations();
    }

    private async Task LoadDestinations()
    {
        if (_disposed) return;
        var shift = _displayShift;
        var version = ++_loadVersion;
        _loading = true;
        _destinations = new Dictionary<int, string>();
        _destinationStatus = "Chargement des destinations…";
        try
        {
            var destinations = await Repository.GetChuteDestinationsAsync(shift, _stopping.Token);
            if (_disposed || version != _loadVersion) return;
            _destinations = destinations;
            _destinationStatus = Repository.IsSimulation ? "Destinations indisponibles en simulation" : null;
        }
        catch (OperationCanceledException) when (_stopping.IsCancellationRequested) { return; }
        catch (Exception exception)
        {
            if (_disposed || version != _loadVersion) return;
            _destinationStatus = "Destinations temporairement indisponibles";
            Logger.LogWarning(exception, "Chargement des dépôts de destination impossible pour le shift {Shift}", shift);
        }
        finally { if (version == _loadVersion) _loading = false; }
        if (_disposed || version != _loadVersion) return;
        _loadedShift = shift;
        _nextRefresh = DateTimeOffset.UtcNow.AddSeconds(60);
    }

    private async Task RefreshDestinations()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(_stopping.Token))
            {
                await InvokeAsync(async () =>
                {
                    if (_loading || (_loadedShift == _displayShift && DateTimeOffset.UtcNow < _nextRefresh)) return;
                    var load = LoadDestinations();
                    StateHasChanged();
                    await load;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_stopping.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _stopping.CancelAsync();
        if (_refreshTask is not null) await _refreshTask;
        _stopping.Dispose();
    }
}
