@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IConveyorSupervisor Supervisor

<dialog @ref="_dialog" class="rslinx-dialog" aria-labelledby="rslinx-title">
    <h2 id="rslinx-title">Redémarrer RSLinx</h2>
    <p>Le redémarrage interrompt les communications automate des deux lignes. Le convoyeur doit être arrêté.</p>
    @if (_message is not null) { <p role="status">@_message</p> }
    <div class="rslinx-actions">
        <button type="button" class="btn" autofocus disabled="@(_busy && !_waitingForConnection)" @onclick="OnClose">@(_waitingForConnection ? "Fermer la fenêtre" : _completed ? "Fermer" : "Annuler")</button>
        @if (!_completed)
        {
            <button type="button" class="btn btn-test" disabled="@_busy" @onclick="Restart">@(_waitingForConnection ? "Reconnexion en cours…" : _busy ? "Redémarrage…" : "Redémarrer RSLinx")</button>
        }
    </div>
</dialog>

@code {
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private bool _disposed;
    private bool _busy;
    private bool _completed;
    private bool _waitingForConnection;
    private string? _message;

    protected override void OnInitialized() => Supervisor.Changed += OnSupervisorChanged;

    private void OnSupervisorChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed || !_waitingForConnection) return;
            RefreshConnection();
            StateHasChanged();
        });
    }

    private void RefreshConnection()
    {
        var running = Supervisor.GetSnapshots().Where(line => line.Running).ToArray();
        if (running.Length > 0 && running.All(line => line.Connections.Plc))
        {
            _waitingForConnection = false;
            _busy = false;
            _completed = true;
            _message = "RSLinx redémarré ; automate connecté.";
            return;
        }

        _message = running.Length == 0
            ? "RSLinx redémarré ; connexions appareils désactivées. Fermer la fenêtre et utiliser CONNECTER pour reconnecter l’automate."
            : "RSLinx redémarré ; reconnexion à l’automate en cours. En attente de la connexion et des lectures automate…";
    }

    private async Task Restart()
    {
        if (_busy) return;
        _busy = true;
        _message = "Redémarrage de RSLinx en cours…";
        try
        {
            await Supervisor.RestartRslinxAsync();
            if (_disposed) return;
            _waitingForConnection = true;
            RefreshConnection();
        }
        catch (Exception exception) { _message = exception.Message; }
        finally { _busy = _waitingForConnection; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./data-wait-modal.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            await module.InvokeVoidAsync("show", _dialog);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Supervisor.Changed -= OnSupervisorChanged;
        if (_module is null) return;
        try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
