        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="configuration" title="Configuration" aria-label="Configuration">
                <span class="bi bi-gear-fill-nav-menu" aria-hidden="true">⚙</span><span class="nav-label">Configuration</span>
            </NavLink>
        </div>

    </nav>
</div>


</div>

@code {
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}
