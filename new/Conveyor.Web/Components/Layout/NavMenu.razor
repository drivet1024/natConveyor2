            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="supervision" title="Supervision" aria-label="Supervision">
                <span class="bi bi-supervision-nav-menu" aria-hidden="true"></span><span class="nav-label">Supervision</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="plan-convoyeur" title="Plan du convoyeur" aria-label="Plan du convoyeur">
