@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="_dialog" class="route-dialog" aria-labelledby="route-dialog-title" @onclose="OnClose">
    <header><h2 id="route-dialog-title">Petits colis — Ligne @(Line.LineId + 1)</h2>
        <button type="button" class="btn" @onclick="OnClose" autofocus>Fermer</button></header>
    <p>@(Line.Maintenance ? "Maintenance" : "Production") · @Line.Counters.SmallParcels.ToString("N0") colis</p>
    @if (Line.Counters.SmallParcelDetails.Count == 0)
    {
        <p>Aucun détail de colis disponible.</p>
    }
    else
    {
        <div class="route-table"><table>
            <thead><tr><th>Heure de passage</th><th>Poids (lb)</th><th>Dimensions L × l × H</th></tr></thead>
            <tbody>@foreach (var parcel in Line.Counters.SmallParcelDetails.Reverse())
            {
                <tr><td>@parcel.ReceivedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")</td><td>@parcel.Weight.ToString("0.##")</td><td>@parcel.Dimension.Length.ToString("0.##") × @parcel.Dimension.Width.ToString("0.##") × @parcel.Dimension.Height.ToString("0.##")</td></tr>
            }</tbody>
        </table></div>
    }
    @if (Line.Counters.SmallParcels > Line.Counters.SmallParcelDetails.Count)
    {
        <p class="details-note">@Line.Counters.SmallParcelDetails.Count détails disponibles sur @Line.Counters.SmallParcels colis. Les 500 derniers détails sont conservés; les anciens compteurs peuvent ne pas avoir de détails.</p>
    }
</dialog>

@code {
    [Parameter, EditorRequired] public LineSnapshot Line { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Layout/SmallParcelsModal.razor.js");
        await _module.InvokeVoidAsync("open", _dialog);
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
