@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="_dialog" class="route-dialog" aria-labelledby="route-dialog-title" @onclose="OnClose">
    <header><h2 id="route-dialog-title">Route non configurée — Ligne @(Line.LineId + 1)</h2>
        <button type="button" class="btn" @onclick="OnClose" autofocus>Fermer</button></header>
    <p>@(Line.Maintenance ? "Maintenance" : "Production") · @Line.Counters.RejectedRouteNotConfigured.ToString("N0") colis</p>
    @if (Line.Counters.UnconfiguredRouteParcels.Count == 0)
    {
        <p>Aucun détail de colis disponible.</p>
    }
    else
    {
        <div class="route-table"><table>
            <thead><tr><th>Heure</th><th>Waybill</th><th>Code postal</th><th>Route de destination</th></tr></thead>
            <tbody>@foreach (var parcel in Line.Counters.UnconfiguredRouteParcels.Reverse())
            {
                <tr><td>@parcel.ReceivedAt.ToLocalTime().ToString("HH:mm:ss")</td><td>@Display(parcel.Waybill)</td>
                    <td>@Display(parcel.PostalCode)</td><td>@(parcel.RouteId?.ToString() ?? "—")</td></tr>
            }</tbody>
        </table></div>
    }
    @if (Line.Counters.RejectedRouteNotConfigured > Line.Counters.UnconfiguredRouteParcels.Count)
    {
        <p class="details-note">@Line.Counters.UnconfiguredRouteParcels.Count détails disponibles sur @Line.Counters.RejectedRouteNotConfigured colis. Les 500 derniers détails sont conservés; les anciens compteurs peuvent ne pas avoir de détails.</p>
    }
</dialog>

@code {
    [Parameter, EditorRequired] public LineSnapshot Line { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Layout/UnconfiguredRoutesModal.razor.js");
        await _module.InvokeVoidAsync("open", _dialog);
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
