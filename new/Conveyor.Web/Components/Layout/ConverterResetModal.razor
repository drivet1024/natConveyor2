@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ConverterResetService ResetService
@inject IConveyorSupervisor Supervisor
@inject IOptions<ConveyorOptions> Options

<dialog @ref="_dialog" class="converter-dialog" aria-labelledby="converter-title">
    <h2 id="converter-title">Commandes — ligne @(LineId + 1)</h2>
    <section class="command-group" aria-labelledby="equipment-title">
        <h3 id="equipment-title">ÉQUIPEMENTS</h3>
        <div class="reset-buttons">
            <button type="button" class="btn btn-start" disabled="@_busy" title="Ouvrir ou relancer les connexions de cette ligne" @onclick="() => SetConnections(true)">CONNECTER</button>
            <button type="button" class="btn btn-stop" disabled="@(_busy || !IsRunning)" title="Fermer les connexions de cette ligne" @onclick="() => SetConnections(false)">DÉCONNECTER</button>
        </div>
    </section>
    <section class="command-group" aria-labelledby="counters-title">
        <h3 id="counters-title">COMPTEURS</h3>
        <div class="reset-buttons">
            <button type="button" class="btn btn-reset" disabled="@_busy" @onclick="ResetCounters">Compteur à 0</button>
        </div>
    </section>
    <section class="command-group" aria-labelledby="restart-title">
        <h3 id="restart-title">REDÉMARRAGE</h3>
        <div class="reset-buttons">
            <button type="button" class="btn reset-device" disabled="@_busy" @onclick="() => Reset(true)">
                <span>Reset Balance</span>
                @if (ConnectedConverterIp(true) is { } scaleIp) { <small>@scaleIp</small> }
            </button>
            <button type="button" class="btn reset-device" disabled="@_busy" @onclick="() => Reset(false)">
                <span>Reset Dimensionneur</span>
                @if (ConnectedConverterIp(false) is { } dimensionIp) { <small>@dimensionIp</small> }
            </button>
        </div>
    </section>
    @if (_message is not null) { <p class="@(_error ? "error" : "message")" role="status">@_message</p> }
    <button type="button" class="btn close-popup" disabled="@_busy" @onclick="OnClose">Fermer</button>
</dialog>

@code {
    [Parameter] public int LineId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private bool _busy;
    private bool _disposed;
    private bool _error;
    private string? _message;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./data-wait-modal.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            await module.InvokeVoidAsync("show", _dialog);
        }
        catch (JSDisconnectedException) { }
    }
    private bool IsRunning => Supervisor.GetSnapshots().Any(line => line.LineId == LineId && line.Running);
    private string? ConnectedConverterIp(bool scale)
    {
        var snapshot = Supervisor.GetSnapshots().FirstOrDefault(line => line.LineId == LineId);
        var connected = scale ? snapshot?.Connections.Scale : snapshot?.Connections.Dimensioner;
        if (connected is not true) return null;
        var line = Options.Value.GetConfiguredLines().FirstOrDefault(line => line.Id == LineId);
        var address = scale ? line?.ScaleConverter.IpAddress : line?.DimensionConverter.IpAddress;
        return string.IsNullOrWhiteSpace(address) ? null : address.Trim();
    }
    private async Task SetConnections(bool connect)
    {
        if (_busy) return;
        _busy = true; _error = false;
        _message = connect ? "Connexion en cours…" : "Déconnexion en cours…";
        try
        {
            if (connect)
            {
                if (IsRunning) await Supervisor.RestartLineAsync(LineId);
                else await Supervisor.StartLineAsync(LineId);
                _message = "Connexions démarrées. Consulter les voyants des appareils.";
            }
            else
            {
                await Supervisor.StopLineAsync(LineId);
                _message = "Connexions fermées.";
            }
        }
        catch (Exception exception) { _error = true; _message = exception.Message; }
        finally { _busy = false; }
    }
    private void ResetCounters()
    {
        Supervisor.ResetCounters(LineId);
        _error = false;
        _message = "Compteurs remis à zéro.";
    }
    private async Task Reset(bool scale)
    {
        if (_busy) return;
        _busy = true; _error = false; _message = "Reset en cours…";
        try
        {
            await ResetService.ResetAsync(LineId, scale);
            _message = "Commande envoyée. L’appareil se reconnectera après son redémarrage.";
        }
        catch (Exception exception) { _error = true; _message = exception.Message; }
        finally { _busy = false; }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
