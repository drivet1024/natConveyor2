@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject UserPresenceCircuit Presence
@inject NavigationManager Navigation
@inject IConveyorSupervisor Supervisor

<div class="page">
    <div class="sidebar @(_menuCollapsed ? "sidebar-collapsed" : "")">
        <NavMenu Collapsed="_menuCollapsed" OnToggle="ToggleMenu" />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
        <footer class="software-footer" aria-label="Version du logiciel">@SoftwareVersion</footer>
    </main>
</div>

@if (Supervisor.Chute4AlarmActive)
{
    <div class="chute-full-backdrop" role="presentation">
        <section class="chute-full-alert" role="alertdialog" aria-modal="true" aria-live="assertive" aria-labelledby="chute-full-title">
            <div class="chute-full-symbol" aria-hidden="true">!</div>
            <h2 id="chute-full-title">CHUTE PLEINE</h2>
        </section>
    </div>
}

@code {
    private static string SoftwareVersion => "ver " + (System.Reflection.CustomAttributeExtensions
        .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(typeof(MainLayout).Assembly)?.InformationalVersion ?? "V1").TrimStart('V', 'v');
    private bool _menuCollapsed = true;
    private IJSObjectReference? _orientation;
    private DotNetObjectReference<MainLayout>? _orientationReference;
    private string? _automaticPlan;
    private bool _disposed;
    private string CurrentPath => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Supervisor.Changed += OnSupervisorChanged;
    }
    private void OnSupervisorChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        if (_automaticPlan is not null && CurrentPath != _automaticPlan) _automaticPlan = null;
    }
    [JSInvokable]
    public Task SetPhoneLandscape(bool landscape) => InvokeAsync(() =>
    {
        if (_disposed) return;
        if (landscape && CurrentPath == "")
        {
            var plan = Supervisor.ConveyorId switch { 1 => "plan-convoyeur", 2 => "plan-convoyeur-sol", _ => null };
            if (plan is null) return;
            _automaticPlan = plan;
            Navigation.NavigateTo(plan, replace: true);
        }
        else if (!landscape && _automaticPlan is not null && CurrentPath == _automaticPlan)
        {
            _automaticPlan = null;
            Navigation.NavigateTo("", replace: true);
        }
    });
    private void ToggleMenu() => _menuCollapsed = !_menuCollapsed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./user-presence.js");
            Presence.Identify(await module.InvokeAsync<string>("browserId"));
            await using var orientationModule = await JS.InvokeAsync<IJSObjectReference>("import", "./phone-orientation.js");
            _orientationReference = DotNetObjectReference.Create(this);
            _orientation = await orientationModule.InvokeAsync<IJSObjectReference>("watch", _orientationReference);
        }
        catch (JSDisconnectedException) { }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Navigation.LocationChanged -= OnLocationChanged;
        Supervisor.Changed -= OnSupervisorChanged;
        try
        {
            if (_orientation is not null)
            {
                await _orientation.InvokeVoidAsync("dispose");
                await _orientation.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        finally { _orientationReference?.Dispose(); }
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
