@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar @(_menuCollapsed ? "sidebar-collapsed" : "")">
        <NavMenu Collapsed="_menuCollapsed" OnToggle="ToggleMenu" />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool _menuCollapsed;
    private void ToggleMenu() => _menuCollapsed = !_menuCollapsed;
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
