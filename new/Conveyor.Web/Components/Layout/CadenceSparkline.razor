@using System.Globalization
@inject IOptions<ConveyorOptions> Options

<div class="cadence-chart">
    <div class="chart-heading"><strong>Cadence horaire</strong><span>colis/h · total des lignes</span></div>
    <small>Calculée toutes les 10 min · volume de l’intervalle ramené à une heure</small>
    @if (_visiblePoints.Count == 0)
    {
        <p>Aucune cadence disponible pour cette période. Un point est calculé toutes les 10 minutes.</p>
    }
    else
    {
        <p class="cadence-latest">Dernier relevé : <strong>@_visiblePoints[^1].ParcelsPerHour.ToString("N0") colis/h</strong> à @_visiblePoints[^1].At.ToLocalTime().ToString("HH:mm")</p>
    }
        <svg viewBox="0 0 480 100" role="img" aria-label="Cadence en colis par heure, de 16 h à 3 h le lendemain, calculée toutes les dix minutes">
            <defs>
                <linearGradient id="@_gradientId" gradientUnits="userSpaceOnUse" x1="0" x2="0" y1="8" y2="78">
                    <stop offset="0" stop-color="#50d98b" />
                    <stop offset="@Offset(GreenAbove)" stop-color="#50d98b" />
                    <stop offset="@Offset(GreenAbove)" stop-color="#ffd15c" />
                    <stop offset="@Offset(YellowFrom)" stop-color="#ffd15c" />
                    <stop offset="@Offset(YellowFrom)" stop-color="#ff6c79" />
                    <stop offset="1" stop-color="#ff6c79" />
                </linearGradient>
            </defs>
            @foreach (var threshold in new[] { 0d, YellowFrom, GreenAbove }.Distinct())
            {
                @if (threshold > 0)
                {
                    <line x1="38" x2="470" y1="@F(Y(threshold))" y2="@F(Y(threshold))" class="grid-line" />
                }
                <g><text x="32" y="@F(Y(threshold) + 3)" text-anchor="end">@threshold</text></g>
            }
            <line x1="38" x2="470" y1="78" y2="78" class="grid-line" />
            @for (var hour = 0; hour <= 11; hour++)
            {
                var x = F(38 + 432d * hour / 11);
                <line x1="@x" x2="@x" y1="78" y2="82" class="grid-line" />
                <g><text x="@x" y="96" text-anchor="@(hour == 0 ? "start" : hour == 11 ? "end" : "middle")">@_windowStart.AddHours(hour).ToString("HH'h'")</text></g>
            }
            @foreach (var segment in Segments(_visiblePoints))
            {
                <polyline points="@string.Join(" ", segment.Select(p => $"{F(X(p.At))},{F(Y(p.ParcelsPerHour))}"))" fill="none" stroke="@($"url(#{_gradientId})")" stroke-width="2" stroke-linejoin="round" />
            }
            @foreach (var point in _visiblePoints)
            {
                <circle cx="@F(X(point.At))" cy="@F(Y(point.ParcelsPerHour))" r="2.5" fill="@PointColor(point.ParcelsPerHour)">
                    <title>@point.At.ToLocalTime().ToString("HH:mm") · @point.ParcelsPerHour.ToString("N0") colis/h</title>
                </circle>
            }
        </svg>
    <small>Vert &gt; @FormatThreshold(GreenAbove) · jaune @FormatThreshold(YellowFrom)–@FormatThreshold(GreenAbove) · rouge &lt; @FormatThreshold(YellowFrom)</small>
</div>

@code {
    [Parameter] public IReadOnlyList<CadencePoint> Points { get; set; } = [];
    [Parameter] public DateTime? HistoryDay { get; set; }
    private readonly string _gradientId = "cadence-" + Guid.NewGuid().ToString("N");
    private DateTime _windowStart;
    private IReadOnlyList<CadencePoint> _visiblePoints = [];
    protected override void OnParametersSet()
    {
        _windowStart = HistoryDay?.Date.AddHours(16) ?? WindowStart(DateTime.Now);
        _visiblePoints = Points.Where(p => p.At.LocalDateTime >= _windowStart && p.At.LocalDateTime <= _windowStart.AddHours(11))
            .OrderBy(p => p.At).ToArray();
    }
    internal static DateTime WindowStart(DateTime localNow) =>
        (localNow.Hour < 16 ? localNow.Date.AddDays(-1) : localNow.Date).AddHours(16);
    internal static IEnumerable<IReadOnlyList<CadencePoint>> Segments(IReadOnlyList<CadencePoint> points)
    {
        List<CadencePoint> segment = [];
        foreach (var point in points)
        {
            if (segment.Count > 0 && point.At - segment[^1].At > TimeSpan.FromMinutes(11))
            {
                yield return segment;
                segment = [];
            }
            segment.Add(point);
        }
        if (segment.Count > 0) yield return segment;
    }
    internal static double Position(DateTime localAt, DateTime start) => 38 + 432 * (localAt - start).TotalHours / 11;
    private double YellowFrom => (double)Options.Value.OperatorKpis.ChartCadenceYellowFrom;
    private double GreenAbove => (double)Options.Value.OperatorKpis.ChartCadenceGreenAbove;
    private static string FormatThreshold(double value) => value.ToString("#,0.##", CultureInfo.GetCultureInfo("fr-CA"));
    private double Maximum => Math.Max(Math.Max(1, GreenAbove * 7 / 6), _visiblePoints.Select(p => p.ParcelsPerHour).DefaultIfEmpty(0).Max() * 1.1);
    private string PointColor(double rate) => rate > GreenAbove ? "#50d98b" : rate >= YellowFrom ? "#ffd15c" : "#ff6c79";
    private double Y(double rate) => 78 - 70 * rate / Maximum;
    private double X(DateTimeOffset at) => Position(at.LocalDateTime, _windowStart);
    private string Offset(double rate) => F(1 - rate / Maximum);
    private static string F(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
}
