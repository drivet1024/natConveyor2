<g id="chute-counters" text-anchor="middle" font-family="system-ui,sans-serif" font-size="14" font-weight="700" fill="#fff">
@foreach (var point in CounterPositions)
{
    var count = Counts.GetValueOrDefault(point.Chute);
    <g @key="(point.Chute, count)" transform="@($"translate({point.X} {point.Y})")" class="@(_changedChutes.Contains(point.Chute) ? "count-flash" : null)">
        <title>Chute @point.Chute : @count colis — destination envoyée</title>
        <rect x="-22" y="-12" width="44" height="24" rx="4" fill="#192a33" stroke="#73909f" />
        <text y="5">@count</text>
    </g>
}
</g>
