    private bool _initialized, _flash1, _flash2;
    private DateTimeOffset? _previous1, _previous2;
    private Dictionary<int, long> _previousCounts = new();
    private HashSet<int> _changedChutes = new();
    protected override void OnParametersSet()
    {
        if (Station1Dispatch != _previous1) _flash1 = _initialized && Station1Dispatch is not null;
        if (Station2Dispatch != _previous2) _flash2 = _initialized && Station2Dispatch is not null;
        if (_initialized)
            foreach (var pair in Counts)
                if (pair.Value > _previousCounts.GetValueOrDefault(pair.Key)) _changedChutes.Add(pair.Key);
        _changedChutes.RemoveWhere(chute => Counts.GetValueOrDefault(chute) == 0);
        _previous1 = Station1Dispatch;
        _previous2 = Station2Dispatch;
        _previousCounts = new(Counts);
        _initialized = true;
    }
