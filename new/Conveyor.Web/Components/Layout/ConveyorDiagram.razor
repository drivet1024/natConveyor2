    [Parameter] public IReadOnlyDictionary<int, long> Traffic15Minutes { get; set; } = new Dictionary<int, long>();
    [Parameter] public IReadOnlyList<int> FullChutes { get; set; } = [];
    [Parameter] public IReadOnlyList<PlcDispatch> Station2Parcels { get; set; } = [];
    private ElementReference _svg;
    private IJSObjectReference? _animation;
    private readonly SemaphoreSlim _animationGate = new(1, 1);
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await _animationGate.WaitAsync();
        try
        {
            if (_disposed) return;
            if (_animation is null)
            {
                var js = Services.GetRequiredService<IJSRuntime>();
                var module = await js.InvokeAsync<IJSObjectReference>("import", "./Components/Layout/ConveyorDiagram.razor.js");
                try
                {
                    if (_disposed) return;
                    _animation = await module.InvokeAsync<IJSObjectReference>("create", _svg);
                }
                finally { await module.DisposeAsync(); }
            }
            if (!_disposed)
                await _animation.InvokeVoidAsync("update", Running, Station1Parcels, Station2Parcels, Traffic15Minutes, FullChutes);
        }
        catch (JSDisconnectedException) { }
        finally { _animationGate.Release(); }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await _animationGate.WaitAsync();
        try
        {
            if (_animation is null) return;
            await _animation.InvokeVoidAsync("dispose");
            await _animation.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        finally { _animationGate.Release(); }
    }
    [Parameter] public bool Running { get; set; }
    [Parameter] public IReadOnlyDictionary<int, long> Counts { get; set; } = new Dictionary<int, long>();
