@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="_dialog" class="action-dialog @(Start ? "" : "stop-dialog")" aria-labelledby="action-title">
    <h2 id="action-title">@(Start ? "Démarrer le convoyeur" : "Arrêter le convoyeur")</h2>
    @if (Start)
    {
        <p>Voulez-vous vraiment démarrer le convoyeur ?</p>
        @if (!CanChangeOperatingMode)
        {
            <p role="status">Le convoyeur doit être arrêté, avec confirmation de l’automate, pour démarrer en maintenance ou revenir de maintenance en production.</p>
        }
        @if (!Completed)
        {
            <div class="start-pin">
                <label for="start-pin">NIP de démarrage</label>
                <input id="start-pin" type="password" inputmode="numeric" maxlength="4" autocomplete="off"
                       @bind="_pin" @bind:event="oninput" disabled="@Busy" aria-describedby="start-pin-help" />
                <small id="start-pin-help">Saisissez le NIP puis choisissez DÉMARRER (production) ou MAINTENANCE.</small>
            </div>
        }
    }
    else
    {
        <p>Pourquoi arrêtez-vous le convoyeur ?</p>
        <div class="stop-reasons">
            <button type="button" class="reason-button pause" disabled="@(Busy || Completed)" @onclick="() => Confirm(0)"><span>PAUSE</span><small>FIN DE SHIFT</small></button>
            <button type="button" class="reason-button jam" disabled="@(Busy || Completed)" @onclick="() => Confirm(1)">JAM</button>
            <button type="button" class="reason-button down" disabled="@(Busy || Completed)" @onclick="() => Confirm(2)">DOWN</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Message)) { <p role="status">@Message</p> }
    <div class="action-buttons @(Start && !Completed ? "start-confirmation" : "")">
        <button type="button" class="btn @(Start && !Completed ? "cancel-start" : "")" autofocus="@(Start && !Completed)" disabled="@Busy" @onclick="OnClose">@(Completed ? "Fermer" : "ANNULER")</button>
        @if (Start && !Completed)
        {
        <button type="button" class="btn btn-start" disabled="@(Busy || !ValidStartPin || (MaintenanceActive && !CanChangeOperatingMode))" @onclick="() => Confirm(null)">DÉMARRER</button>
        <button type="button" class="btn btn-test" disabled="@(Busy || !ValidStartPin || !CanChangeOperatingMode)" @onclick="ConfirmMaintenance">MAINTENANCE</button>
        }
    </div>
</dialog>

@code {
    [Parameter] public bool Start { get; set; }
    [Parameter] public bool Completed { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CanChangeOperatingMode { get; set; }
    [Parameter] public bool MaintenanceActive { get; set; }
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback<int?> OnConfirm { get; set; }
    [Parameter] public EventCallback OnMaintenance { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private bool _disposed;
    private string _pin = "";
    private bool ValidStartPin => _pin == "1980";
    private Task Confirm(int? cause) => Busy || Completed || (Start && (!ValidStartPin || (MaintenanceActive && !CanChangeOperatingMode))) ? Task.CompletedTask : OnConfirm.InvokeAsync(cause);
    private Task ConfirmMaintenance() => Busy || Completed || !Start || !ValidStartPin || !CanChangeOperatingMode ? Task.CompletedTask : OnMaintenance.InvokeAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./data-wait-modal.js");
            if (_disposed) { await module.DisposeAsync(); return; }
            _module = module;
            await module.InvokeVoidAsync("show", _dialog);
        }
        catch (JSDisconnectedException) { }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
