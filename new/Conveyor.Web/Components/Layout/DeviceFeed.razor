<section class="device-feed" aria-label="Réception des appareils">
    <div class="feed-heading"><strong>RÉCEPTION EN DIRECT</strong><span>@(Line.Connections.Simulated ? "DONNÉES SIMULÉES" : "DERNIÈRES TRAMES REÇUES")</span></div>
    @DeviceRow("DIMENSIONNEUR", Line.DimensionInput, Line.Connections.Dimensioner)
    @DeviceRow("BALANCE", Line.ScaleInput, Line.Connections.Scale)
    <div class="camera-plc-row @(!string.IsNullOrWhiteSpace(Line.PlcTransferTag) ? "has-transfer" : null)">
        @DeviceRow("CAMÉRA", Line.CameraInput, Line.Connections.Camera, Line.LastPlcDispatch)
        @PlcReadout("AUTOMATE", Line.PlcTag, Line.PlcInput, Line.PlcTagSupported)
        @if (!string.IsNullOrWhiteSpace(Line.PlcTransferTag))
        {
            @PlcReadout("TRANSFERT", Line.PlcTransferTag, Line.PlcTransferInput, Line.PlcTransferTagSupported)
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public LineSnapshot Line { get; set; } = default!;
    private RenderFragment PlcReadout(string name, string tag, DeviceReception? input, bool supported) => @<div class="plc-feed">
        <div class="feed-label"><strong>@name · @tag</strong></div>
        <div class="feed-payload">
            @if (input is not null)
            {
                <code>@Visible(input.Raw)</code>
                <span class="feed-time"><span @key="input.Sequence" class="receive-pulse" aria-hidden="true"></span>@input.ReceivedAt.ToString("HH:mm:ss.fff")</span>
            }
            else { <span class="feed-empty">@(supported ? "En attente de valeur automate" : "Lecture automate indisponible")</span> }
            @if (!Line.Connections.Plc) { <span class="feed-empty"> · Déconnecté</span> }
        </div>
    </div>;
    private RenderFragment DeviceRow(string name, DeviceReception? input, bool connected, PlcDispatch? dispatch = null) => @<div class="feed-row">
        <div class="feed-label">
            <strong>@name</strong>
            <small>@(Line.Connections.Simulated ? "Simulation" : connected ? "Connecté" : "Déconnecté")</small>
            @if (dispatch is not null)
            {
                <div @key="dispatch.Sequence" class="plc-dispatch">
                    <small class="plc-dispatch-label">Envoi automate · @dispatch.Chute</small>
                    <small class="plc-dispatch-time">@dispatch.SentAt.ToString("HH:mm:ss.fff")</small>
                </div>
            }
        </div>
        <div class="feed-payload">
            @if (input is null) { <span class="feed-empty">Aucune trame reçue</span> }
            else
            {
                <code>@Visible(input.Raw)@(input.Truncated ? " … [tronquée]" : "")</code>
                <span class="feed-time"><span @key="input.Sequence" class="receive-pulse" aria-hidden="true"></span>@input.ReceivedAt.ToString("HH:mm:ss.fff") · trame @input.Sequence</span>
            }
        </div>
    </div>;
    private static string Visible(string raw) => string.Concat(raw.Select(character => character switch
    {
        '\r' => "⟨CR⟩", '\n' => "⟨LF⟩", '\u0002' => "⟨STX⟩", '\u0003' => "⟨ETX⟩",
        '\t' => "⟨TAB⟩", _ => char.IsControl(character) ? $"⟨0x{(int)character:X2}⟩" : character.ToString()
    }));
}
