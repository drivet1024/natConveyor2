@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="_dialog" class="route-dialog" aria-labelledby="route-dialog-title" @onclose="OnClose">
    <header><h2 id="route-dialog-title">Pas dans le système — Ligne @(Line.LineId + 1)</h2>
        <button type="button" class="btn" @onclick="OnClose" autofocus>Fermer</button></header>
    <p>@(Line.Maintenance ? "Maintenance" : "Production") · @Line.Counters.RejectedShipmentNotFound.ToString("N0") colis</p>
    @if (Line.Counters.MissingShipmentCustomers.Count == 0)
    {
        <p>Aucun détail de colis disponible.</p>
    }
    else
    {
        <div class="route-table"><table>
            <thead><tr><th>N° client</th><th>Préfixes</th><th>Colis</th></tr></thead>
            <tbody>@foreach (var parcel in Line.Counters.MissingShipmentCustomers.OrderByDescending(row => row.Count).ThenBy(row => row.Customers))
            {
                <tr><td>@parcel.Customers</td><td>@parcel.Prefixes</td><td>@parcel.Count.ToString("N0")</td></tr>
            }</tbody>
        </table></div>
    }
    @if (Line.Counters.RejectedShipmentNotFound > DetailedCount)
    {
        <p class="details-note">@DetailedCount colis détaillés sur @Line.Counters.RejectedShipmentNotFound. Les anciens compteurs peuvent ne pas avoir de détail par client.</p>
    }
    <p class="details-note">Attribution selon les préfixes de validation. Plusieurs numéros sur une ligne indiquent une attribution ambiguë; le colis est compté une seule fois.</p>
</dialog>

@code {
    [Parameter, EditorRequired] public LineSnapshot Line { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    private long DetailedCount => Line.Counters.MissingShipmentCustomers.Sum(row => row.Count);
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Layout/MissingShipmentCustomersModal.razor.js");
        await _module.InvokeVoidAsync("open", _dialog);
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}


