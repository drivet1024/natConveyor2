@using System.Globalization

<section class="history-panel" aria-labelledby="history-chart-title">
    <div class="history-panel-heading">
        <div><span class="eyebrow">30 DERNIERS JOURS</span><h2 id="history-chart-title">Résultats par shift</h2></div>
        <span class="history-period">Chaque ligne correspond à un shift enregistré</span>
    </div>

    @if (Points.Count == 0)
    {
        <div class="history-empty">Aucune statistique enregistrée pour cette période.</div>
    }
    else
    {
        <div class="history-kpis">
            <div><strong>@Last.TotalParcels.ToString("N0")</strong><span>colis au dernier shift</span></div>
            <div><strong>@FormatPercent(Last.BalanceErrorPercent)</strong><span>erreurs balance au dernier shift</span></div>
            <div><strong>@FormatPercent(Last.DimensionErrorPercent)</strong><span>erreurs dimensionneur au dernier shift</span></div>
        </div>
        <div class="history-table-scroll" role="region" aria-label="Statistiques des shifts enregistrés" tabindex="0">
            <table class="history-table">
                <thead>
                    <tr>
                        <th scope="col">Début du shift</th>
                        <th scope="col">Colis</th>
                        <th scope="col">Erreurs balance</th>
                        <th scope="col">Erreurs dimensionneur</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var point in Points.Reverse())
                    {
                        <tr>
                            <th scope="row">@point.ShiftStart.ToString("dd MMM yyyy · HH:mm", CultureInfo.GetCultureInfo("fr-CA"))</th>
                            <td class="numeric parcels">@point.TotalParcels.ToString("N0")</td>
                            <td class="numeric">@FormatPercent(point.BalanceErrorPercent)</td>
                            <td class="numeric">@FormatPercent(point.DimensionErrorPercent)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Points.Any(point => point.DimensionErrorPercent is null))
        {
            <p class="history-note">— signifie que le taux d’erreurs du dimensionneur n’est pas disponible pour ce shift.</p>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StatisticsHistoryPoint> Points { get; set; } = [];
    private StatisticsHistoryPoint Last => Points[^1];
    private static string FormatPercent(double value) => value.ToString("0.##", CultureInfo.GetCultureInfo("fr-CA")) + " %";
    private static string FormatPercent(double? value) => value.HasValue ? FormatPercent(value.Value) : "—";
}
