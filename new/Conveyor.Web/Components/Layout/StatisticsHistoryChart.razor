@using System.Globalization

<section class="history-panel" aria-labelledby="history-chart-title">
    <div class="history-panel-heading">
        <div><span class="eyebrow">30 DERNIERS JOURS</span><h2 id="history-chart-title">Résultats par shift</h2></div>
        <span class="history-period">Shifts avec au moins un colis traité</span>
    </div>

    @if (_activePoints.Count == 0)
    {
        <div class="history-empty">Aucun colis traité enregistré pour cette période.</div>
    }
    else
    {
        <div class="history-kpis">
            <div><strong>@Last.TotalParcels.ToString("N0")</strong><span>colis au dernier shift</span></div>
            <div><strong>@FormatPercent(Last.BalanceErrorPercent)</strong><span>erreurs balance au dernier shift</span></div>
            <div><strong>@FormatPercent(Last.DimensionErrorPercent)</strong><span>erreurs dimensionneur au dernier shift</span></div>
        </div>
        <div class="history-table-scroll" role="region" aria-label="Statistiques des shifts enregistrés" tabindex="0">
            <table class="history-table">
                <thead>
                    <tr>
                        <th scope="col">Début du shift</th>
                        <th scope="col">Colis</th>
                        <th scope="col">Triés</th>
                        <th scope="col" title="Somme des cadences des lignes, calculées selon leur temps de marche">Cadence totale (colis/h)</th>
                        <th scope="col">Sans lecture</th>
                        <th scope="col">Erreurs balance</th>
                        <th scope="col">Erreurs dimensionneur</th>
                        <th scope="col">Code 68</th>
                        <th scope="col">Pas dans le système</th>
                        <th scope="col">Route non configurée</th>
                        <th scope="col">Plusieurs code-barres</th>
                        <th scope="col">Code 98</th>
                        <th scope="col">Colis légers</th>
                        <th scope="col">Petits colis</th>
                        <th scope="col">Dimensions inversées</th>
                        <th scope="col">Fautes balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var point in _activePoints.Reverse())
                    {
                        <tr>
                            <th scope="row">@point.ShiftStart.ToString("dd MMM yyyy · HH:mm", CultureInfo.GetCultureInfo("fr-CA"))</th>
                            <td class="numeric parcels">@point.TotalParcels.ToString("N0")</td>
                            <td class="numeric">@FormatPercent(point.SortedPercent)</td>
                            <td class="numeric">@(point.TotalParcelsPerHour?.ToString("N0", CultureInfo.GetCultureInfo("fr-CA")) ?? "—")</td>
                            <td class="numeric">@FormatPercent(point.NoReadPercent)</td>
                            <td class="numeric">@FormatPercent(point.BalanceErrorPercent)</td>
                            <td class="numeric">@FormatPercent(point.DimensionErrorPercent)</td>
                            <td class="numeric">@FormatPercent(point.Code68Percent)</td>
                            <td class="numeric">@FormatPercent(point.ShipmentNotFoundPercent)</td>
                            <td class="numeric">@FormatPercent(point.RouteNotConfiguredPercent)</td>
                            <td class="numeric">@FormatPercent(point.MultipleBarcodesPercent)</td>
                            <td class="numeric">@FormatPercent(point.Code98Percent)</td>
                            <td class="numeric">@FormatPercent(point.LightParcelPercent)</td>
                            <td class="numeric">@FormatPercent(point.SmallParcelPercent)</td>
                            <td class="numeric">@FormatPercent(point.InverseDimensionPercent)</td>
                            <td class="numeric">@(point.ScaleFaults?.ToString("N0") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_activePoints.Any(HasMissingDetail))
        {
            <p class="history-note">— signifie que cette statistique détaillée n’était pas encore enregistrée pour ce shift.</p>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StatisticsHistoryPoint> Points { get; set; } = [];
    private IReadOnlyList<StatisticsHistoryPoint> _activePoints = [];
    protected override void OnParametersSet() => _activePoints = Points.Where(point => point.TotalParcels > 0).ToArray();
    private StatisticsHistoryPoint Last => _activePoints[^1];
    private static string FormatPercent(double value) => value.ToString("0.##", CultureInfo.GetCultureInfo("fr-CA")) + " %";
    private static string FormatPercent(double? value) => value.HasValue ? FormatPercent(value.Value) : "—";
    private static bool HasMissingDetail(StatisticsHistoryPoint point) =>
        point.TotalParcelsPerHour is null || point.DimensionErrorPercent is null || point.ShipmentNotFoundPercent is null ||
        point.RouteNotConfiguredPercent is null || point.MultipleBarcodesPercent is null ||
        point.NoReadPercent is null || point.InverseDimensionPercent is null;
}
